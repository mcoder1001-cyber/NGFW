[Unit]
Description=NGFW isolated remote-access engine %i
BindsTo=ngfw-agent.service
After=ngfw-agent.service
ConditionPathExists=/run/ngfw/ra/%i/network.json

[Service]
Type=simple
User=root
Group=root
NetworkNamespacePath=/run/ngfw/ra/%i/netns
ExecStart=/usr/lib/ngfw/ngfw-ra-daemon %i
UMask=0077
Restart=no
KillMode=control-group
TimeoutStopSec=15
PrivateTmp=yes
PrivateDevices=yes
PrivatePIDs=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @debug
RestrictRealtime=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_IPC_LOCK
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Hide host management sockets and sealed-cache material from daemon root.
# Only this profile's namespace/config/PKI is visible; only its VICI child writes.
TemporaryFileSystem=/run /etc /var/lib /var/log /opt
BindReadOnlyPaths=/run/ngfw/ra/%i /opt/ngfw-ra -/etc/ld.so.cache /etc/passwd /etc/group /etc/nsswitch.conf /etc/protocols /etc/services -/etc/localtime
BindPaths=/run/ngfw/ra/%i/daemon
InaccessiblePaths=-/data -/boot -/var/backups -/var/spool -/mnt -/media
ReadWritePaths=/proc/sys/net
StandardOutput=null
StandardError=null
LimitCORE=0
LimitNOFILE=4096
TasksMax=128
MemoryMax=512M
