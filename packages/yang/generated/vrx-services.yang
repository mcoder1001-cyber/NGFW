          type boolean;
          default "true";
        }
        leaf prefer {
          type boolean;
          default "false";
        }
        leaf minPoll {
          type int32 {
            range "-6..24";
          }
        }
        leaf maxPoll {
          type int32 {
            range "-6..24";
          }
        }
        leaf nts {
          type boolean;
          default "false";
        }
        leaf keyRef {
          type string {
            pattern "(key)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "1..127";
          }
