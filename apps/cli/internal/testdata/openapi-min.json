           "clientId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[\\x21-\\x7e]+$",
            "title": "Client identifier",
            "type": "string",
            "x-vrx-ui": {
             "help": "option 61; absent = the interface MAC address",
             "order": 2
            }
           },
           "hostname": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
            "title": "Hostname",
            "type": "string",
            "x-vrx-ui": {
             "help": "sent in option 12; absent = the system hostname",
             "order": 1
            }
           },
           "setBroadcastFlag": {
            "default": false,
            "title": "Broadcast flag",
            "type": "boolean",
            "x-vrx-ui": {
             "help": "ask the server to broadcast its replies",
             "order": 3
            }
           }
          },
          "title": "DHCP client",
          "type": "object",
          "x-vrx-ui": {
           "group": "addressing",
           "help": "obtain an IPv4 address by DHCP; cannot be combined with unnumbered",
           "order": 14
          }
         },
         "dot1ad": {
          "default": false,
          "title": "802.1ad outer tag",
          "type": "boolean",
          "x-vrx-ui": {
           "group": "encapsulation",
           "help": "use an 802.1ad (0x88a8) outer tag instead of 802.1Q (0x8100)",
           "order": 7
          }
         },
         "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean",
          "x-vrx-ui": {
           "group": "general",
           "help": "admin state; interfaces stay down until enabled",
           "order": 1
          }
         },
         "innerVlanId": {
          "maximum": 4094,
          "minimum": 1,
          "title": "Inner VLAN ID",
          "type": "integer",
          "x-vrx-ui": {
           "group": "encapsulation",
           "help": "inner tag for QinQ (two-tag) sub-interfaces",
           "order": 6,
           "widget": "number"
          }
         },
         "ipv4": {
          "default": [],
          "items": {
           "format": "cidrv4",
           "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\/([0-9]|[1-2][0-9]|3[0-2])$",
           "title": "IPv4 CIDR",
           "type": "string",
           "x-vrx-ui": {
            "help": "e.g. 10.0.0.1/24",
            "widget": "cidr"
           }
          },
          "maxItems": 32,
          "title": "IPv4 addresses",
          "type": "array",
          "x-vrx-ui": {
           "group": "addressing",
           "help": "addresses with prefix length, e.g. 10.0.0.1/24",
           "order": 10
          }
         },
         "ipv6": {
          "default": [],
          "items": {
           "format": "cidrv6",
           "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))\\/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$",
           "title": "IPv6 CIDR",
           "type": "string",
           "x-vrx-ui": {
            "help": "e.g. 2001:db8::1/64",
            "widget": "cidr"
           }
          },
          "maxItems": 32,
          "title": "IPv6 addresses",
          "type": "array",
          "x-vrx-ui": {
           "group": "addressing",
           "help": "addresses with prefix length, e.g. 2001:db8::1/64",
           "order": 11
          }
         },
         "mtu": {
          "maximum": 9216,
          "minimum": 68,
          "title": "MTU",
          "type": "integer",
          "x-vrx-ui": {
           "group": "general",
           "help": "L3 MTU in bytes (68\u20139216); absent = keep the driver default",
           "order": 3,
           "widget": "number"
          }
         },
         "unnumbered": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\/[0-9a-fA-F]+)*(?:\\.[0-9]+)?$",
          "title": "IP unnumbered",
          "type": "string",
          "x-vrx-ui": {
           "group": "addressing",
           "help": "borrow the addresses of this interface (e.g. loop0); ipv4/ipv6 must then be empty",
           "order": 13,
           "widget": "interface-picker"
          }
         },
         "vlanId": {
          "maximum": 4094,
          "minimum": 1,
          "title": "VLAN ID",
          "type": "integer",
          "x-vrx-ui": {
           "group": "encapsulation",
           "help": "outer 802.1Q (or 802.1ad) tag",
           "order": 5,
           "widget": "number"
          }
         },
         "vrf": {
          "default": "default",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "VRF",
          "type": "string",
          "x-vrx-ui": {
           "group": "addressing",
           "help": "routing table this interface belongs to",
           "order": 12,
           "widget": "vrf-picker"
          }
         }
        },
        "required": [
         "vlanId"
        ],
        "type": "object"
       },
       "default": {},
       "propertyNames": {
        "pattern": "^(?:0|[1-9][0-9]{0,9})$",
        "title": "Sub-interface ID",
        "type": "string",
        "x-vrx-ui": {
         "widget": "number"
        }
       },
       "title": "Sub-interfaces",
       "type": "object",
       "x-vrx-ui": {
        "group": "subinterfaces",
        "help": "802.1Q / QinQ sub-interfaces keyed by sub-interface id (usually the VLAN id)",
        "order": 20
       }
      },
      "unnumbered": {
       "maxLength": 63,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\/[0-9a-fA-F]+)*(?:\\.[0-9]+)?$",
       "title": "IP unnumbered",
       "type": "string",
       "x-vrx-ui": {
        "group": "addressing",
        "help": "borrow the addresses of this interface (e.g. loop0); ipv4/ipv6 must then be empty",
        "order": 13,
        "widget": "interface-picker"
       }
      },
      "vrf": {
       "default": "default",
       "maxLength": 63,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
       "title": "VRF",
       "type": "string",
       "x-vrx-ui": {
        "group": "addressing",
        "help": "routing table this interface belongs to",
        "order": 12,
        "widget": "vrf-picker"
       }
      }
     },
     "type": "object"
    },
    "default": {},
    "description": "Physical, virtual and sub-interfaces keyed by VPP interface name.",
    "propertyNames": {
     "maxLength": 63,
     "minLength": 1,
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\/[0-9a-fA-F]+)*$",
     "title": "Interface",
     "type": "string",
     "x-vrx-ui": {
      "widget": "interface-picker"
     }
    },
    "title": "Interfaces",
    "type": "object",
    "x-vrx-ui": {
     "order": 30
    }
   },
   "RootConfig": {
    "additionalProperties": false,
    "description": "The whole configuration document (docs/04). Secret leaves are write-only and never returned.",
    "properties": {
     "interfaces": {
      "$ref": "#/components/schemas/InterfacesConfig"
     },
     "system": {
      "$ref": "#/components/schemas/SystemConfig"
     }
    },
    "type": "object"
   },
   "SystemConfig": {
    "additionalProperties": false,
    "default": {},
    "description": "Hostname, timezone, login banners and DNS client settings.",
    "properties": {
     "banner": {
      "additionalProperties": false,
      "default": {},
      "properties": {
       "login": {
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
        "title": "Pre-login banner",
        "type": "string",
        "x-vrx-ui": {
         "help": "shown before authentication (SSH issue, web login page)",
         "order": 1,
         "widget": "textarea"
        }
       },
       "motd": {
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
        "title": "Message of the day",
        "type": "string",
        "x-vrx-ui": {
         "help": "shown after a successful login",
         "order": 2,
         "widget": "textarea"
        }
       }
      },
      "title": "Banners",
      "type": "object",
      "x-vrx-ui": {
       "group": "identity",
       "order": 3
      }
     },
     "dns": {
      "additionalProperties": false,
      "default": {},
      "properties": {
       "searchDomains": {
        "default": [],
        "items": {
         "maxLength": 253,
         "minLength": 1,
         "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
         "title": "Hostname",
         "type": "string",
         "x-vrx-ui": {}
        },
        "maxItems": 6,
        "title": "Search domains",
        "type": "array",
        "x-vrx-ui": {
         "order": 2
        }
       },
       "servers": {
        "default": [],
        "items": {
         "anyOf": [
          {
           "format": "ipv4",
           "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$",
           "type": "string"
          },
          {
           "format": "ipv6",
           "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$",
           "type": "string"
          }
         ],
         "title": "IP address",
         "x-vrx-ui": {
          "widget": "ip"
         }
        },
        "maxItems": 8,
        "title": "Name servers",
        "type": "array",
        "x-vrx-ui": {
         "help": "upstream resolvers for the system itself",
         "order": 1
        }
       },
       "vrf": {
        "default": "default",
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "title": "VRF",
        "type": "string",
        "x-vrx-ui": {
         "help": "VRF used to reach the name servers",
         "order": 3,
         "widget": "vrf-picker"
        }
       }
      },
      "title": "DNS client",
      "type": "object",
      "x-vrx-ui": {
       "group": "name-resolution",
       "order": 4
      }
     },
     "hostname": {
      "default": "vrx",
      "maxLength": 253,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "title": "Hostname",
      "type": "string",
      "x-vrx-ui": {
       "group": "identity",
       "help": "RFC 1123 host name, e.g. vrx-a or vrx-a.lab.example",
       "order": 1
      }
     },
     "timezone": {
      "default": "UTC",
      "maxLength": 64,
      "pattern": "^[A-Z][A-Za-z0-9_+-]*(?:\\/[A-Z0-9][A-Za-z0-9_+-]*)*$",
      "title": "Time zone",
      "type": "string",
      "x-vrx-ui": {
       "group": "identity",
       "help": "IANA name, e.g. Asia/Tehran",
       "order": 2,
       "widget": "timezone-picker"
      }
     }
    },
    "title": "System",
    "type": "object",
    "x-vrx-ui": {
     "order": 10
    }
   }
  }
 },
 "info": {
  "title": "testdata subset of the vrx-api OpenAPI (interfaces + system)",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/config/commit": {
   "post": {
    "operationId": "Config_commit",
    "parameters": [
     {
      "in": "query",
      "name": "comment",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "confirm",
      "required": false,
      "schema": {
       "maximum": 3600,
       "minimum": 1,
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": false,
         "properties": {
          "confirmDeadline": {
           "type": "string"
          },
          "notApplied": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "results": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "code": {
              "type": "string"
             },
             "key": {
              "type": "string"
             },
             "message": {
              "type": "string"
             },
             "op": {
              "type": "string"
             },
             "pointer": {
              "type": "string"
             },
             "subsystem": {
              "type": "string"
             }
            },
            "required": [
             "key",
             "op",
             "code",
             "message",
             "pointer",
             "subsystem"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "revision": {
           "additionalProperties": false,
           "properties": {
            "author": {
             "type": [
              "string",
              "null"
             ]
            },
            "authorId": {
             "anyOf": [
              {
               "maximum": 9007199254740991,
               "minimum": -9007199254740991,
               "type": "integer"
              },
              {
               "type": "null"
              }
             ]
            },
            "comment": {
             "type": "string"
            },
            "createdAt": {
             "type": "string"
            },
            "hash": {
             "type": "string"
            },
            "id": {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            "kind": {
             "type": "string"
            },
            "parentId": {
             "anyOf": [
              {
               "maximum": 9007199254740991,
               "minimum": -9007199254740991,
               "type": "integer"
              },
              {
               "type": "null"
              }
             ]
            },
            "txnId": {
             "type": [
              "string",
