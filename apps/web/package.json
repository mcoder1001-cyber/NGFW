{
  "name": "@ngfw/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "echo 'web: nothing to generate'",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/bundle-budget.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && node scripts/check-logical-css.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@ngfw/api-client": "workspace:*",
    "@ngfw/ui-kit": "workspace:*",
    "@tanstack/react-query": "^5",
    "i18next": "^25",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^15",
    "react-router": "^7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint-plugin-i18next": "^6",
    "jsdom": "^26",
    "typescript": "^5.6",
    "vite": "^7",
    "vitest": "^3"
  }
