# Generated by vrx-agent (RF-3 unbound renderer). Do not edit: the next commit overwrites it.
# vrx-input: 
# resolver "guest"
# resolver "lan"
server:
	directory: "/run/vrx-test/w0/unbound"
	chroot: ""
	username: ""
	pidfile: "/run/vrx-test/w0/unbound/unbound.pid"
	do-daemonize: no
	use-syslog: no
	logfile: "/run/vrx-test/w0/unbound/unbound.log"
	verbosity: 1
	port: 3653
	interface: 127.0.0.1@3653
	interface: 127.0.0.2@3653
	num-threads: 1
	msg-cache-size: 4m
	rrset-cache-size: 8m
	cache-min-ttl: 0
	cache-max-ttl: 86400
	prefetch: no
	qname-minimisation: yes
	hide-identity: yes
	hide-version: yes
	log-queries: no
	harden-glue: yes
	harden-below-nxdomain: yes
	harden-dnssec-stripped: yes
	access-control: 127.0.0.0/8 allow
	auto-trust-anchor-file: "/run/vrx-test/w0/unbound/root.key"
	interface-view: 127.0.0.2@3653 guest
	interface-view: 127.0.0.1@3653 lan

remote-control:
	control-enable: yes
	control-interface: "/run/vrx-test/w0/unbound/unbound.ctl"
	control-use-cert: no

view:
	name: "guest"
	view-first: yes
	local-zone: "guest.example.test." static
	local-data: 'portal.guest.example.test. 3600 IN A 10.6.20.1'

view:
	name: "lan"
	view-first: yes
	local-zone: "lan.example.test." static
	local-data: 'portal.lan.example.test. 3600 IN A 10.6.10.1'

forward-zone:
	name: "corp.test."
	forward-addr: 192.0.2.1@53
	forward-first: no
	forward-tls-upstream: no

