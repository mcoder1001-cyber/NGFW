        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf description {
          type string {
            // pattern dropped: not XSD-expressible
            length "0..255";
          }
        }
        leaf type {
          type enumeration {
            enum "1r2c";
            enum "1r3c-rfc2697";
            enum "2r3c-rfc2698";
            enum "2r3c-rfc4115";
            enum "2r3c-mef5cf1";
          }
          default "1r2c";
          description "1r2c = single rate, two colours; 1r3c = RFC 2697; 2r3c = RFC 2698 / RFC 4115 / MEF 5 CF1 (two rates)";
        }
        leaf rateUnit {
          type enumeration {
            enum "kbps";
            enum "pps";
          }
          default "kbps";
          description "Rates in kbit/s (bursts in bytes) or packets/s (bursts in packets)";
        }
