          list ext {
            // keyless: no itemKey meta — config lists need a key (documented deviation, RESTCONF orders by index)
            ordered-by user;
            description "Translation used when the packet's QoS bits were recorded from ext (0–255); unlisted values map to 0";
            leaf from {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
            leaf to {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
          }
          list vlan {
            // keyless: no itemKey meta — config lists need a key (documented deviation, RESTCONF orders by index)
            ordered-by user;
            description "Translation used when the packet's QoS bits were recorded from vlan (0–7); unlisted values map to 0";
            leaf from {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
            leaf to {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
          }
          list mpls {
            // keyless: no itemKey meta — config lists need a key (documented deviation, RESTCONF orders by index)
            ordered-by user;
            description "Translation used when the packet's QoS bits were recorded from mpls (0–7); unlisted values map to 0";
            leaf from {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
            leaf to {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
          }
          list ip {
            // keyless: no itemKey meta — config lists need a key (documented deviation, RESTCONF orders by index)
