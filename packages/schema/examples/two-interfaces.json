{
  "system": { "hostname": "vrx-a", "timezone": "UTC" },
  "vrfs": {
    "default": { "id": 0, "description": "global routing table" },
    "customer-a": { "id": 10, "description": "customer A" }
  },
  "interfaces": {
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "description": "uplink",
      "mtu": 9000,
      "ipv4": ["10.0.0.1/24"],
      "ipv6": ["2001:db8::1/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "description": "customer A access",
      "mtu": 1500,
      "ipv4": ["192.168.10.1/24"],
      "vrf": "customer-a",
      "subinterfaces": {
        "100": { "vlanId": 100, "ipv4": ["192.168.100.1/24"], "vrf": "customer-a" }
      }
    }
  },
  "routing": {
    "static": [
      {
        "prefix": "0.0.0.0/0",
        "nextHops": [{ "address": "10.0.0.254", "weight": 1 }],
        "vrf": "default"
      }
    ]
  }
}
