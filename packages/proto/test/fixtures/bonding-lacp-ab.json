{
  "interfaces": {
    "BondEthernet0": {
      "enabled": true,
      "description": "LACP uplink",
      "mtu": 9000,
      "ipv4": ["192.0.2.1/24"],
      "ipv6": ["2001:db8::1/64"],
      "vrf": "default",
      "bond": {
        "mode": "lacp",
