        leaf shaper {
          type string {
            pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
            length "1..63";
          }
          description "Name in qos.shapers";
        }
        leaf record {
          type enumeration {
            enum "ext";
            enum "vlan";
            enum "mpls";
            enum "ip";
          }
          description "Ingress: copy the DSCP / PCP / EXP of this header into the packet QoS record (qos record)";
        }
        container store {
          description "Ingress: give every received packet this QoS value for the source slot (qos store)";
          leaf source {
            type enumeration {
              enum "ext";
              enum "vlan";
              enum "mpls";
              enum "ip";
            }
            mandatory true;
          }
          leaf value {
            type uint32 {
              range "0..255";
            }
            mandatory true;
          }
        }
        container mark {
          leaf map {
            type string {
              pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
              length "1..63";
            }
            mandatory true;
            description "Name in qos.maps";
          }
          leaf output {
            type enumeration {
              enum "ext";
              enum "vlan";
              enum "mpls";
              enum "ip";
            }
            mandatory true;
            description "Header rewritten on egress from the recorded QoS bits through the map (qos mark)";
          }
        }
      }
    }
    container nsim {
      description "VPP nsim: delay, bandwidth and loss between two cross-connected interfaces or on output. A lab tool; applied only by the globals owner.";
      leaf delayMs {
        type decimal64 {
          fraction-digits 6;
        }
        mandatory true;
        description "one-way delay added to every frame (engine delay_in_usec; microsecond resolution)";
      }
      leaf bandwidthMbps {
        type decimal64 {
          fraction-digits 6;
        }
        mandatory true;
        description "simulated link rate; frames beyond it are queued and then dropped";
      }
      leaf packetSize {
        type uint32 {
          range "64..9000";
        }
        default "1500";
        description "sizes the scheduler wheel (64–9000)";
      }
      leaf dropFraction {
        type decimal64 {
          fraction-digits 6;
        }
        default "0";
        description "0 = no random loss; 0.01 = one frame in 100 (engine packets_per_drop = 1 / fraction)";
      }
      container crossConnect {
        description "two interfaces joined through the simulator (the engine keeps one pair)";
        leaf a {
          type string {
            pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
            length "1..63";
          }
          mandatory true;
        }
        leaf b {
          type string {
            pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
            length "1..63";
          }
          mandatory true;
        }
      }
      leaf-list outputInterfaces {
        type string {
          pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
          length "1..63";
        }
        description "interfaces whose transmitted frames go through the simulator (output feature)";
      }
    }
    container hostStack {
      description "VPP host stack (advanced, T3): session layer, app namespaces, session rules, TCP source addresses";
      leaf enabled {
        type boolean;
        default "false";
        description "Required state of the engine session layer (rule-table engine); set only by the globals owner";
      }
      list namespaces {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf secretRef {
          type string {
            pattern "(key)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "1..127";
          }
          description "key/<name>; not applied until the API→agent secret channel exists";
        }
        leaf interface {
          type string {
            pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
            length "1..63";
          }
        }
        leaf vrf {
          type string {
            pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
            length "1..63";
          }
          default "default";
          description "Routing table this object belongs to (first-class, never implicit)";
        }
      }
      list sessionRules {
        // keyless: no itemKey meta — config lists need a key (documented deviation, RESTCONF orders by index)
        ordered-by user;
        leaf tag {
          type string {
            pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
            length "1..40";
          }
          mandatory true;
        }
        leaf scope {
          type enumeration {
            enum "global";
            enum "local";
          }
          default "global";
        }
        leaf transport {
          type enumeration {
            enum "tcp";
            enum "udp";
          }
          mandatory true;
        }
        leaf local {
          type union {
            type string {
              pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])/([0-9]|[1-2][0-9]|3[0-2])";
            }
            type string {
              pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9])";
            }
          }
          mandatory true;
        }
        leaf localPort {
          type uint32 {
            range "1..65535";
          }
          description "unset = any";
        }
        leaf remote {
          type union {
            type string {
              pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])/([0-9]|[1-2][0-9]|3[0-2])";
            }
            type string {
              pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9])";
            }
          }
          mandatory true;
        }
        leaf remotePort {
          type uint32 {
            range "1..65535";
          }
          description "unset = any";
        }
        leaf action {
          type enumeration {
            enum "allow";
            enum "deny";
            enum "redirect";
          }
          mandatory true;
        }
        leaf redirectAppIndex {
          type uint32 {
            range "0..4294967295";
          }
          description "required with action redirect";
        }
        leaf appNamespace {
          type string {
            pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
            length "1..40";
          }
          description "unset = default";
        }
      }
      container tcpSourceAddresses {
        leaf first {
          type union {
            type string {
              pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
            }
            type string {
              pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
            }
          }
          mandatory true;
        }
        leaf last {
          type union {
            type string {
              pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
            }
            type string {
              pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
            }
          }
          mandatory true;
        }
        leaf vrf {
          type string {
            pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
            length "1..63";
          }
          default "default";
          description "Routing table this object belongs to (first-class, never implicit)";
        }
      }
      container httpStatic {
        leaf enabled {
          type boolean;
          default "false";
        }
        leaf wwwRootPath {
          type string {
            length "18..255";
          }
          mandatory true;
          description "Directory under /var/lib/vrx/www/";
        }
        leaf uri {
          type string {
            pattern "(tcp|tls)://[0-9A-Fa-f.:]+/[0-9]{1,5}";
            length "1..255";
          }
          mandatory true;
          description "tcp://<one of this box's management addresses>/<port>, e.g. tcp://192.0.2.10/8080";
        }
        leaf cacheSizeMb {
          type uint32 {
            range "1..4095";
          }
          default "10";
        }
      }
    }
    container autoSdl {
      description "automatic source deny list of the engine host stack (an engine-global setting); absent = off";
      leaf enabled {
        type boolean;
        default "false";
        description "deny new host-stack TCP sessions from a source that exceeds the threshold";
      }
      leaf threshold {
        type uint32 {
          range "1..4294967295";
        }
        default "5";
        description "hits from one source before its deny entry is created";
      }
      leaf removeTimeoutSec {
        type uint32 {
          range "1..4294967295";
        }
        default "300";
        description "lifetime of an automatic deny entry";
      }
    }
    container lb {
      description "VPP lb plugin: virtual IPs spread over application servers (GRE, L3DSR or NAT; Maglev hashing). Tier T3: no health checks, no L7. Write-only in VPP 26.06; deleted VIPs linger until the lb garbage collection (V20).";
      container settings {
        description "Engine-wide lb settings; applied only by the globals owner";
        leaf ip4Source {
          type string {
            pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
          }
          description "outer source of gre4 packets and SNAT source of nat4 nodeport VIPs (engine default 255.255.255.255)";
        }
        leaf ip6Source {
          type string {
            pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
          }
          description "outer source of gre6 packets and SNAT source of nat6 nodeport VIPs (engine default ffff:…:ffff)";
        }
        leaf flowBuckets {
          type uint32 {
            range "1..1048576";
          }
          description "a power of two (engine default 1024; unset keeps the current value)";
        }
        leaf flowTimeoutSec {
          type uint32 {
            range "1..86400";
          }
          description "idle time after which a flow may move to another server (engine default 40; unset keeps the current value)";
        }
      }
      list vips {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        description "keyed by name";
        leaf prefix {
          type union {
            type string {
              pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])/([0-9]|[1-2][0-9]|3[0-2])";
            }
            type string {
              pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9])";
            }
          }
          mandatory true;
          description "the virtual address, usually a /32 or /128; installed in the default table (table 0)";
        }
        leaf protocol {
          type enumeration {
            enum "any";
            enum "tcp";
            enum "udp";
          }
          default "any";
          description "any = every protocol and port of the prefix (no port); tcp or udp need a port";
        }
        leaf port {
          type uint32 {
            range "1..65535";
          }
          description "destination port of a tcp/udp VIP; absent for protocol any";
        }
        leaf encap {
          type enumeration {
            enum "gre4";
            enum "gre6";
            enum "l3dsr";
            enum "nat4";
            enum "nat6";
          }
          mandatory true;
          description "gre4/gre6: GRE tunnel to the server; l3dsr: DSCP rewrite for direct server return (IPv4); nat4/nat6: destination NAT to the server";
        }
        leaf dscp {
          type uint32 {
            range "0..63";
          }
          description "DSCP written into the packet so the server can tell the VIP (l3dsr only; default 0)";
        }
        leaf srvType {
          type enumeration {
            enum "clusterip";
            enum "nodeport";
          }
          description "clusterip: SNAT source is the VIP; nodeport: SNAT source is settings.ip4Source/ip6Source (nat4/nat6 only; default clusterip)";
        }
        leaf targetPort {
          type uint32 {
            range "1..65535";
          }
          description "port on the application server the NAT VIP translates to (nat4/nat6, required)";
        }
        leaf nodePort {
          type uint32 {
            range "1..65535";
          }
          description "node port of a nodeport VIP; the engine accepts but does not use it (the API handler ignores node_port)";
        }
        leaf newFlowsTableLength {
          type uint32 {
            range "1..1048576";
          }
          default "1024";
          description "entries of the Maglev consistent-hash table (a power of two; more entries = finer spread over the servers)";
        }
        leaf srcIpSticky {
          type boolean;
          default "false";
          description "hash on the source address only, so every flow of a client goes to the same server";
        }
        list servers {
          key "address";
          description "the servers new flows are spread over (no health checks: a server stays until removed here)";
          leaf address {
            type union {
              type string {
                pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
              }
              type string {
                pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
              }
            }
            mandatory true;
            description "application server; IPv4 for gre4, l3dsr and nat4, IPv6 for gre6 and nat6";
          }
          leaf flushOnDelete {
            type boolean;
            default "false";
            description "when the server is removed, also drop its entries from the sticky flow table (existing flows move at once)";
          }
        }
      }
      list natInterfaces {
        key "interface family";
        description "interfaces with the lb NAT in2out feature (needed by nat4/nat6 VIPs)";
        leaf interface {
          type string {
            pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
            length "1..63";
          }
          mandatory true;
          description "interface the application servers answer on (engine lb-nat4-in2out / lb-nat6-in2out feature)";
        }
        leaf family {
          type enumeration {
            enum "ip4";
            enum "ip6";
          }
          mandatory true;
        }
      }
    }
  }
}
