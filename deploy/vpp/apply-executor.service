[Unit]
Description=NGFW root dataplane apply executor
Requires=apply-executor.socket
After=apply-executor.socket

[Service]
ExecStart=/usr/bin/python3 /usr/lib/ngfw/apply-executor.py
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStopSec=1300
