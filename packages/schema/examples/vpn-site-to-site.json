{
  "system": {
    "hostname": "ngfw-a"
  },
  "vrfs": {
    "default": {
      "id": 0,
      "description": "global routing table"
    },
    "customer-a": {
      "id": 10,
      "description": "customer A"
    }
  },
  "interfaces": {
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "description": "uplink",
      "mtu": 1500,
      "ipv4": ["198.51.100.2/30"],
      "ipv6": ["2001:db8:0:1::2/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "description": "lan",
      "mtu": 1500,
      "ipv4": ["192.168.10.1/24"],
      "ipv6": ["2001:db8:10::1/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/2": {
      "enabled": true,
      "description": "customer A access",
      "mtu": 1500,
      "ipv4": ["10.20.0.1/24"],
      "vrf": "customer-a",
      "rxMode": "polling"
    }
  },
  "tunnels": {
    "ipip": {
      "ipip-site-b": {
        "instance": 0,
        "src": "198.51.100.2",
        "dst": "203.0.113.10",
        "underlayVrf": "default",
        "vrf": "default",
        "ipv4": ["10.255.0.1/30"]
      }
    }
  },
  "vpn": {
    "ipsec": {
      "settings": {
        "cryptoEngine": "auto",
        "asyncCrypto": false
      },
      "proposals": {
        "ike2-aes256gcm": {
          "description": "IKEv2 AEAD suite",
          "ike": {
            "encr": "aes256",
            "integ": "sha256",
            "prf": "prfsha256",
            "dh": "modp2048"
          },
          "esp": {
            "encr": "aes256gcm16"
          }
        }
      },
      "tunnels": {
        "site-b": {
          "description": "route-based tunnel to site B",
          "ikeVersion": 2,
          "localAddr": "198.51.100.2",
          "remoteAddr": "203.0.113.10",
          "localId": "@ngfw-a.lab.example",
          "remoteId": "@ngfw-b.lab.example",
          "auth": {
            "method": "psk",
            "secretRef": "psk/site-b"
          },
          "proposal": "ike2-aes256gcm",
          "startAction": "none",
          "vrf": "default",
          "routeBased": {
            "ipipInterface": "ipip-site-b"
          },
          "engine": "vpp-ikev2"
        }
      }
    }
  },
  "routing": {
    "static": [
      {
        "prefix": "0.0.0.0/0",
        "vrf": "default",
        "nextHops": [
          {
            "address": "198.51.100.1"
          }
        ]
      },
      {
        "prefix": "10.99.0.0/16",
        "vrf": "default",
        "nextHops": [
          {
            "interface": "ipip-site-b"
          }
        ]
      }
    ]
  }
}
