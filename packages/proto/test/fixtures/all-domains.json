          { "ip": "192.168.200.20", "port": 8443, "probability": 50, "vrf": "customer-a" },
          { "ip": "192.168.200.21", "port": 8443, "probability": 50 }
        ],
        "affinity": 0,
        "twiceNat": false,
        "selfTwiceNat": false,
        "out2inOnly": false
      }
    ],
    "timeouts": { "udp": 300, "tcpEstablished": 7440, "tcpTransitory": 240, "icmp": 60 },
    "ipfix": { "enabled": true, "domainId": 1, "sourcePort": 4739 },
