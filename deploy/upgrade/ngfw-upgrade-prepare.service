[Unit]
Description=NGFW upgrade pre-migration database snapshot
After=postgresql.service
# D-254: Wants=, not Requires=: a restart of PostgreSQL must not restart this oneshot and,
# through the .requires links on ngfw-firstboot.service and ngfw-api.service, VPP; the
# snapshot fails on its own when PostgreSQL is down and then blocks firstboot and the API.
Wants=postgresql.service
Before=ngfw-firstboot.service ngfw-api.service
ConditionPathExists=/etc/ngfw/upgrade.json

[Service]
Type=oneshot
ExecStart=/usr/lib/ngfw/ngfw-upgrade-prepare
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
RequiredBy=ngfw-api.service ngfw-firstboot.service
