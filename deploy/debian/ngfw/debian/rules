#!/usr/bin/make -f
# Inputs are staged by prepare.sh, never downloaded by a maintainer script.
%:
	dh $@

override_dh_auto_configure:
	@test -s stage/VPP_VERSION || { echo 'Missing verified VPP artifact version' >&2; exit 1; }
	@test -x stage/usr/sbin/ngfw-agent
	@test -x stage/usr/sbin/ngfw-startupgen
	@test -f stage/usr/lib/ngfw/api/dist/main.js
	@test -f stage/usr/share/ngfw/web/index.html

override_dh_auto_build:

override_dh_auto_test:
	python3 tests/test_packaging.py
	python3 tests/test_system_identity.py
	python3 tests/test_firstboot.py
	python3 tests/test_base_policy.py
	python3 tests/test_pppoe_assets.py

override_dh_auto_install:

override_dh_gencontrol:
	dh_gencontrol -- -Vngfw:VppVersion=$$(cat stage/VPP_VERSION)

# D-253: a package upgrade changes files on disk and nothing about running units.
# Without --no-stop-on-upgrade the generated preinst stops every shipped unit on
# upgrade; stopping the completed provisioning oneshots (ngfw-firstboot.service,
# ngfw-firewall-bootstrap.service) propagates through Requires= to vpp.service,
# nftables.service, the agent and the API, and --no-start never brings them
# back. Units are still stopped on removal (prerm remove); the operator restarts
# the daemons it chooses (deploy/deploy-hosts.sh restarts agent and API).
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade

# CGO_ENABLED=0 Go binaries have compressed DWARF that dwz cannot optimize.
# Keep dwz processing enabled for all other native package contents.
override_dh_dwz:
	dh_dwz -Xngfw-agent -Xngfw-startupgen -Xngfw-vppcheck -Xngfw-ra-daemon -Xngfw-ra-namespace-broker -Xngfw-wan-probe

# Preserve the executable bytes bound by the prepared RA and WAN checksum receipts.
override_dh_strip:
	dh_strip -Xngfw-ra-daemon -Xngfw-ra-namespace-broker -Xngfw-wan-probe
