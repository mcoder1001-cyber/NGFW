# Generated by ngfw-startupgen from the `dataplane` domain of the NGFW configuration.
# Do not edit by hand: changes need a VPP restart, applied by the manager procedure in
# docs/agent/renderers/vppstartup.md.

unix {
  nodaemon
  runtime-dir /run/ngfw-test/w20/vpp
  log /run/ngfw-test/w20/vpp/vpp.log
  full-coredump
  cli-listen /run/ngfw-test/w20/vpp/cli.sock
  gid vpp
}

api-trace {
  on
}

api-segment {
  prefix w20
  gid vpp
}

socksvr {
  socket-name /run/ngfw-test/w20/vpp/api.sock
}

statseg {
  socket-name /run/ngfw-test/w20/vpp/stats.sock
  size 32M
}

memory {
  main-heap-size 512M
  main-heap-page-size 4k
}

cpu {
  main-core 21
}

buffers {
  buffers-per-numa 4096
  page-size 4k
}

plugins {
  plugin dpdk_plugin.so { disable }
  plugin linux_cp_plugin.so { disable }
  plugin linux_nl_plugin.so { disable }
  plugin npt66_plugin.so { enable }
}
