#cloud-config
# NGFW appliance — unattended install (P14). Rendered by deploy/image/iso/build-iso.sh into /nocloud/user-data on the
# ISO; GRUB boots the installer with `autoinstall ds=nocloud;s=/cdrom/nocloud/`, so subiquity asks nothing.
# Version @NGFW_VERSION@. No secret is in this file: the admin password is generated on the target by late-commands.
autoinstall:
  version: 1
  # no section is interactive: the installer never stops for input
  interactive-sections: []
  early-commands:
    # refuses to wipe an existing NGFW disk unless booted with ngfw.reinstall=1 (stops the reboot-into-the-ISO loop),
    # adapts the boot-loader target to BIOS vs UEFI, and makes the per-install LUKS key when the ISO has --luks
    - [bash, /cdrom/ngfw/installer/ngfw-early.sh]
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Etc/UTC
  source:
    id: @SOURCE_ID@
    search_drivers: false
  network:
    version: 2
    ethernets:
      ngfw-en:
        match:
          name: "en*"
        dhcp4: true
        optional: true
      ngfw-eth:
        match:
          name: "eth*"
        dhcp4: true
        optional: true
  apt:
    # the installer never needs the network: with no (or an unreachable) mirror it installs from the ISO alone;
    # the pocket switches keep an online install identical to an offline one (no install-time upgrades)
    preserve_sources_list: false
    geoip: false
    fallback: offline-install
    disable_suites: [updates, security, backports, proposed]
@STORAGE@
  ssh:
    install-server: true
    allow-pw: false
  codecs:
    install: false
  drivers:
    install: false
  oem:
    install: false
  updates: security
  # no default user (no identity section): administration is the web UI's bootstrap admin; SSH keys for root are
  # optional (build-iso.sh --ssh-authorized-keys) and installed by late-commands. cloud-init is purged on bare
  # metal, so this user-data is only what the schema needs: no users, root's keys left alone.
  user-data:
    users: []
    disable_root: false
  late-commands:
    - [bash, /cdrom/ngfw/installer/ngfw-late.sh, /target]
  error-commands:
    - [sh, -c, 'cp -a /var/log/ngfw-late.log /var/log/installer/ 2>/dev/null; echo "NGFW install FAILED — logs in /var/log/installer" > /dev/console']
  shutdown: reboot
