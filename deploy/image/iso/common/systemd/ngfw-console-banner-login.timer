# P14 deploy/image common (F-images reuses it): polls for the first admin login every 30 s while the bootstrap
# password file exists; ngfw-console-banner check-login disables this timer once the password is gone.
[Unit]
Description=NGFW bootstrap password check (until the first admin login)
ConditionPathExists=/var/lib/ngfw-image/console/bootstrap-password

[Timer]
OnBootSec=90s
OnUnitActiveSec=30s
AccuracySec=5s

[Install]
WantedBy=timers.target
