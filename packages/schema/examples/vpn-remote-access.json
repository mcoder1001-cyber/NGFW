{
  "vrfs": {
    "default": { "id": 0, "description": "global routing table" },
    "customer-a": { "id": 10, "description": "customer A" }
  },
  "interfaces": {
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "description": "uplink",
      "mtu": 1500,
      "ipv4": ["198.51.100.2/30"],
      "ipv6": ["2001:db8:0:1::2/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "description": "lan",
      "mtu": 1500,
      "ipv4": ["192.168.10.1/24"],
      "ipv6": ["2001:db8:10::1/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/2": {
      "enabled": true,
      "description": "customer A access",
      "mtu": 1500,
      "ipv4": ["10.20.0.1/24"],
      "vrf": "customer-a",
      "rxMode": "polling"
    }
  },
  "vpn": {
    "ipsec": {
      "proposals": {
        "ike2-aes256gcm": {
          "ike": { "encr": "aes256gcm16", "prf": "prfsha384", "dh": "ecp256" },
          "esp": { "encr": "aes256gcm16" }
        }
      }
    },
    "pki": {
      "cas": {
        "corp-ca": {
          "certificateRef": "cert/corp-ca",
          "crl": { "url": "https://pki.lab.example/corp.crl" }
        }
      },
      "certificates": {
        "vrx-a": {
          "certificateRef": "cert/vrx-a",
          "privateKeyRef": "key/vrx-a",
          "ca": "corp-ca"
        },
        "public-web": {
          "privateKeyRef": "key/public-web",
          "acme": { "domains": ["vpn.lab.example"], "email": "noc@lab.example" }
        }
      }
    },
    "remoteAccess": {
      "road-warriors": {
        "localAddr": "198.51.100.2",
        "localId": "vpn.lab.example",
        "vrf": "default",
        "auth": "eap-mschapv2",
        "certificate": "vrx-a",
        "proposal": "ike2-aes256gcm",
        "pools": [{ "name": "pool4", "prefix": "10.250.0.0/24", "dns": ["192.168.10.1"] }],
        "splitTunnel": ["192.168.10.0/24"],
        "users": [{ "username": "alice", "passwordRef": "password/alice" }]
      }
    }
  }
}
