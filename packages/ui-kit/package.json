  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema-form": {
      "types": "./dist/schema-form/index.d.ts",
      "import": "./dist/schema-form/index.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid/index.d.ts",
      "import": "./dist/data-grid/index.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "import": "./dist/ws/index.js"
    }
  },
  "scripts": {
    "gen": "echo 'ui-kit: nothing to generate'",
    "build": "tsc -p tsconfig.build.json",
