### /etc/ppp/ipv6-down.d/ngfw-wan0 mode=-rwxr-xr-x
#!/bin/sh
# ngfw-agent PPPoE ipv6-down hook (F-pppoe-client, IPv6 = slaac). pppd runs this after IPv6CP and sets
# PPP_IFACE, PPP_IPPARAM, LLLOCAL, LLREMOTE, PPPD_PID. It only acts for our own session (PPP_IPPARAM) and keeps
# "<hostif>.state6" current for the agent: the global addresses and IPv6 default router the kernel holds on the
# PPP link (SLAAC from the ISP's Router Advertisements). Rendered; hand edits are overwritten.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "${PPP_IPPARAM:-}" = "ngfw-wan0" ] || exit 0
iface="${PPP_IFACE:-}"
case "$iface" in ''|*[!A-Za-z0-9_.-]*) exit 0 ;; esac
self="$0"
dir="/srv/run/ngfw/pppoe"
f="$dir/wan0.state6"
pidf="$dir/wan0.ipv6.pid"
pdf="$dir/wan0.pd"
mkdir -p "$dir"
ll="${LLLOCAL:-}"
case "$ll" in *[!0-9A-Fa-f:]*) ll="" ;; esac
peer="${LLREMOTE:-}"
case "$peer" in *[!0-9A-Fa-f:]*) peer="" ;; esac
since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# stop ends this session's refresher (and the DHCPv6 client it supervises) and waits until they are gone, so a
# late refresh can never overwrite the down state.
stop() {
  [ -f "$pidf" ] || return 0
  while read -r p; do
    case "$p" in ''|*[!0-9]*) continue ;; esac
    kill "$p" 2>/dev/null || true
    n=0
    while kill -0 "$p" 2>/dev/null && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
  done < "$pidf"
  rm -f "$pidf"
}

# write PHASE renders the state file atomically and only when its content changed.
write() {
  tmp="$f.tmp.$$"
  {
    echo "phase=$1"
    echo "hostif=wan0"
    echo "ppp_iface=$iface"
    echo "lllocal=$ll"
    echo "llremote=$peer"
    if [ "$1" = up ]; then
      ip -6 -o addr show dev "$iface" scope global -tentative -dadfailed 2>/dev/null | awk '{print "addr=" $4}'
      ip -6 route show default dev "$iface" 2>/dev/null | awk '$2 == "via" {print "gw=" $3; exit}'
      [ -f "$pdf" ] && grep '^pd=' "$pdf"
    fi
    echo "at=$since"
  } > "$tmp"
  if cmp -s "$tmp" "$f"; then rm -f "$tmp"; else mv -f "$tmp" "$f"; fi
}

stop
rm -f "$pdf"
write down
exit 0

### /etc/ppp/ipv6-down.d/ngfw-wan2 mode=-rwxr-xr-x
#!/bin/sh
# ngfw-agent PPPoE ipv6-down hook (F-pppoe-client, IPv6 = dhcpv6). pppd runs this after IPv6CP and sets
# PPP_IFACE, PPP_IPPARAM, LLLOCAL, LLREMOTE, PPPD_PID. It only acts for our own session (PPP_IPPARAM) and keeps
# "<hostif>.state6" current for the agent: the global addresses and IPv6 default router the kernel holds on the
# PPP link (SLAAC from the ISP's Router Advertisements, plus the DHCPv6 IA_NA address dhcpcd adds)
# and the DHCPv6-PD prefix the dhcpcd event script records. Rendered; hand edits are overwritten.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "${PPP_IPPARAM:-}" = "ngfw-wan2" ] || exit 0
iface="${PPP_IFACE:-}"
case "$iface" in ''|*[!A-Za-z0-9_.-]*) exit 0 ;; esac
self="$0"
dir="/srv/run/ngfw/pppoe"
f="$dir/wan2.state6"
pidf="$dir/wan2.ipv6.pid"
pdf="$dir/wan2.pd"
mkdir -p "$dir"
ll="${LLLOCAL:-}"
case "$ll" in *[!0-9A-Fa-f:]*) ll="" ;; esac
peer="${LLREMOTE:-}"
case "$peer" in *[!0-9A-Fa-f:]*) peer="" ;; esac
since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# stop ends this session's refresher (and the DHCPv6 client it supervises) and waits until they are gone, so a
# late refresh can never overwrite the down state.
stop() {
  [ -f "$pidf" ] || return 0
  while read -r p; do
    case "$p" in ''|*[!0-9]*) continue ;; esac
    kill "$p" 2>/dev/null || true
    n=0
    while kill -0 "$p" 2>/dev/null && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
  done < "$pidf"
  rm -f "$pidf"
}

# write PHASE renders the state file atomically and only when its content changed.
write() {
  tmp="$f.tmp.$$"
  {
    echo "phase=$1"
    echo "hostif=wan2"
    echo "ppp_iface=$iface"
    echo "lllocal=$ll"
    echo "llremote=$peer"
    if [ "$1" = up ]; then
      ip -6 -o addr show dev "$iface" scope global -tentative -dadfailed 2>/dev/null | awk '{print "addr=" $4}'
      ip -6 route show default dev "$iface" 2>/dev/null | awk '$2 == "via" {print "gw=" $3; exit}'
      [ -f "$pdf" ] && grep '^pd=' "$pdf"
    fi
    echo "at=$since"
  } > "$tmp"
  if cmp -s "$tmp" "$f"; then rm -f "$tmp"; else mv -f "$tmp" "$f"; fi
}

