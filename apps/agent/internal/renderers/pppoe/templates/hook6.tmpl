#!/bin/sh
# ngfw-agent PPPoE {{.Kind}} hook (F-pppoe-client, IPv6 = {{.IPv6}}). pppd runs this after IPv6CP and sets
# PPP_IFACE, PPP_IPPARAM, LLLOCAL, LLREMOTE, PPPD_PID. It only acts for our own session (PPP_IPPARAM) and keeps
# "<hostif>.state6" current for the agent: the global addresses and IPv6 default router the kernel holds on the
# PPP link (SLAAC from the ISP's Router Advertisements{{if eq .IPv6 "dhcpv6"}}, plus the DHCPv6 IA_NA address dhcpcd adds{{end}}){{if eq .IPv6 "dhcpv6"}}
# and the DHCPv6-PD prefix the dhcpcd event script records{{end}}. Rendered; hand edits are overwritten.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "${PPP_IPPARAM:-}" = {{quoted .Remotename}} ] || exit 0
iface="${PPP_IFACE:-}"
case "$iface" in ''|*[!A-Za-z0-9_.-]*) exit 0 ;; esac
self="$0"
dir={{quoted .StateDir}}
f="$dir/{{ident .HostIf}}.state6"
pidf="$dir/{{ident .HostIf}}.ipv6.pid"
pdf="$dir/{{ident .HostIf}}.pd"
mkdir -p "$dir"
ll="${LLLOCAL:-}"
case "$ll" in *[!0-9A-Fa-f:]*) ll="" ;; esac
peer="${LLREMOTE:-}"
case "$peer" in *[!0-9A-Fa-f:]*) peer="" ;; esac
since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# stop ends this session's refresher (and the DHCPv6 client it supervises) and waits until they are gone, so a
# late refresh can never overwrite the down state.
stop() {
  [ -f "$pidf" ] || return 0
  while read -r p; do
    case "$p" in ''|*[!0-9]*) continue ;; esac
    kill "$p" 2>/dev/null || true
    n=0
    while kill -0 "$p" 2>/dev/null && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
  done < "$pidf"
  rm -f "$pidf"
}

# write PHASE renders the state file atomically and only when its content changed.
write() {
  tmp="$f.tmp.$$"
  {
    echo "phase=$1"
    echo "hostif={{ident .HostIf}}"
    echo "ppp_iface=$iface"
    echo "lllocal=$ll"
    echo "llremote=$peer"
    if [ "$1" = up ]; then
      ip -6 -o addr show dev "$iface" scope global -tentative -dadfailed 2>/dev/null | awk '{print "addr=" $4}'
      ip -6 route show default dev "$iface" 2>/dev/null | awk '$2 == "via" {print "gw=" $3; exit}'
      [ -f "$pdf" ] && grep '^pd=' "$pdf"
    fi
    echo "at=$since"
  } > "$tmp"
  if cmp -s "$tmp" "$f"; then rm -f "$tmp"; else mv -f "$tmp" "$f"; fi
}
{{if eq .Phase "up"}}
# Run the refresher as its own shell so $$ is the PID recorded by the parent.
# Losing that PID file (configuration edit) revokes this instance's ownership.
c="/proc/sys/net/ipv6/conf/$iface"
if [ "${1:-}" = refresh ]; then
  n=0
  while [ "$(cat "$pidf" 2>/dev/null)" != "$$" ]; do
    [ "$n" -lt 50 ] || exit 0
    sleep 0.1
    n=$((n + 1))
  done
  owns() { [ "$(cat "$pidf" 2>/dev/null)" = "$$" ]; }
  cleanup() {
    trap - EXIT TERM INT
{{- if eq .IPv6 "dhcpv6"}}
    if [ -n "${d:-}" ]; then kill "$d" 2>/dev/null || true; wait "$d" 2>/dev/null || true; fi
{{- end}}
    if owns; then
      if [ -e "$self" ]; then write down; else rm -f "$f"; fi
      rm -f "$pidf" "$pdf"
    fi
  }
  trap cleanup EXIT
  trap 'exit 0' TERM INT
{{- if eq .IPv6 "dhcpv6"}}
  {{.DhcpcdBin}} -B -f {{quoted .DhcpcdConf}} "$iface" </dev/null >/dev/null 2>&1 &
  d=$!
{{- end}}
  while owns && [ -d "$c" ] && [ -e "$self" ] && { [ -z "${PPPD_PID:-}" ] || kill -0 "$PPPD_PID" 2>/dev/null; }; do
    write up
    sleep 2
  done
  exit 0
fi
stop
rm -f "$pdf"
# Kernel SLAAC on the PPP link (accept_ra=2: the box forwards). The IPv6 default route is learned from the RA only
# when the session carries the default route.
echo 2 > "$c/accept_ra"
echo 1 > "$c/autoconf"
echo {{if .DefaultRoute}}1{{else}}0{{end}} > "$c/accept_ra_defrtr"
# pppd added the link-local (with the peer, nodad) before the sysctls above, so the kernel did not solicit;
# re-adding it the same way sends the Router Solicitation now instead of waiting for the ISP's next periodic RA.
if [ -n "$ll" ] && [ -n "$peer" ]; then
  ip -6 addr del "$ll" peer "$peer" dev "$iface" 2>/dev/null || true
  ip -6 addr add "$ll" peer "$peer" dev "$iface" nodad 2>/dev/null || true
fi
write up
"$self" refresh </dev/null >/dev/null 2>&1 &
echo "$!" > "$pidf"
{{- else}}
stop
rm -f "$pdf"
write down
{{- end}}
exit 0
