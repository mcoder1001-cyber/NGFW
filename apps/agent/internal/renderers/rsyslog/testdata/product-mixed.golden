# Rendered by vrx-agent (rsyslog renderer). Do not edit: every commit overwrites this file.
module(load="impstats" interval="1" format="json" log.file="/var/spool/rsyslog/vrx-impstats.json" log.syslog="off" resetCounters="off")
template(name="vrx_rfc5424" type="string" string="<%PRI%>1 %TIMESTAMP:::date-rfc3339% %HOSTNAME% %APP-NAME% %PROCID% %MSGID% %STRUCTURED-DATA% %msg%\n")

ruleset(name="vrx_export_0_9a3a9bdc") {
    action(type="omfwd" name="vrx_export_0_9a3a9bdc" target="192.0.2.10" port="5514" protocol="udp"
           template="vrx_rfc5424" queue.type="LinkedList" queue.size="10000" action.resumeRetryCount="-1")
}
if prifilt("kern,local7.warning") then {
    call vrx_export_0_9a3a9bdc
}

ruleset(name="vrx_export_1_d23921f8") {
    action(type="omfwd" name="vrx_export_1_d23921f8" target="2001:db8::5" port="514" protocol="tcp" TCP_Framing="traditional"
           template="RSYSLOG_TraditionalForwardFormat" queue.type="LinkedList" queue.size="50000" action.resumeRetryCount="-1")
}
if prifilt("*.err") then {
    call vrx_export_1_d23921f8
}

ruleset(name="vrx_export_2_a8c022d1") {
