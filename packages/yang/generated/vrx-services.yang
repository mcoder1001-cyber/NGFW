        type string {
          pattern "[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*";
          length "1..253";
        }
      }
      leaf sysLocation {
        type string {
          pattern "[ -~]+";
          length "1..255";
        }
      }
      leaf sysContact {
        type string {
          pattern "[ -~]+";
          length "1..255";
        }
      }
      list communities {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf secretRef {
          type string {
            pattern "(password)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "1..127";
          }
          mandatory true;
          description "The community string itself is a secret (kind password) and is never part of the document";
        }
        leaf access {
          type enumeration {
            enum "ro";
            enum "rw";
          }
          default "ro";
        }
        leaf-list sources {
          type union {
            type string {
              pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])/([0-9]|[1-2][0-9]|3[0-2])";
            }
            type string {
              pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9])";
            }
          }
          description "Empty = any";
        }
        leaf view {
          type string {
            pattern "[A-Za-z0-9_.-]{1,64}";
          }
          description "Name in snmp.views; empty = everything";
        }
      }
      list v3Users {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf securityLevel {
          type enumeration {
            enum "noAuthNoPriv";
            enum "authNoPriv";
            enum "authPriv";
          }
          default "authPriv";
        }
        leaf authProtocol {
          type enumeration {
            enum "sha";
            enum "sha256";
            enum "sha512";
            enum "md5";
          }
          default "sha";
        }
        leaf authRef {
          type string {
            pattern "(password)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "1..127";
          }
          description "Reference to a stored secret of kind password. The secret itself is never part of the configuration.";
        }
        leaf privProtocol {
          type enumeration {
            enum "aes";
            enum "aes256";
            enum "des";
          }
          default "aes";
        }
        leaf privRef {
          type string {
            pattern "(password)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "1..127";
          }
          description "Reference to a stored secret of kind password. The secret itself is never part of the configuration.";
        }
        leaf access {
          type enumeration {
            enum "ro";
            enum "rw";
          }
          default "ro";
        }
        leaf view {
          type string {
            pattern "[A-Za-z0-9_.-]{1,64}";
          }
          description "Name in snmp.views; empty = everything";
        }
      }
