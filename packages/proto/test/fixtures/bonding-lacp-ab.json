        "numaOnly": true
      }
    },
    "TenGigabitEthernet0/0/0": { "enabled": true, "mtu": 9000 },
    "TenGigabitEthernet0/0/1": { "enabled": true, "mtu": 9000 },
    "TenGigabitEthernet0/0/2": { "enabled": true },
    "TenGigabitEthernet0/0/3": { "enabled": true }
  }
