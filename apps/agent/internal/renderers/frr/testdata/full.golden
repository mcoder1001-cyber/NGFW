frr version 10.7.1
frr defaults traditional
hostname vrx-a
log syslog informational
service integrated-vtysh-config
!
vrf w12red
 ip route 10.12.210.0/24 blackhole
 ipv6 route 2001:db8:12:10::/64 w12r0 tag 9 5
exit-vrf
!
interface w12f0
 description uplink
exit
!
ip route 10.12.200.0/24 10.12.1.1
ip route 10.12.201.0/24 blackhole tag 100 50
ip route 10.12.202.0/24 w12f0
ip route 10.12.203.0/24 10.12.1.1 w12f0 200
ip route 10.12.204.0/24 10.12.1.2
ip route 10.12.204.0/24 10.12.1.3
ipv6 route 2001:db8:12::/64 2001:db8:12::1
ipv6 route 2001:db8:12:1::/64 blackhole tag 7
ipv6 route 2001:db8:12:2::/64 fe80::1 w12f0 20
!
router bgp 65012
 bgp router-id 10.12.0.1
exit
!
end
