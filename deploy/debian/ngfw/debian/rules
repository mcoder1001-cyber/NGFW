#!/usr/bin/make -f
# Inputs are staged by prepare.sh, never downloaded by a maintainer script.
%:
	dh $@

override_dh_auto_configure:
	@test -s stage/VPP_VERSION || { echo 'Missing verified VPP artifact version' >&2; exit 1; }
	@test -x stage/usr/sbin/ngfw-agent
	@test -x stage/usr/sbin/ngfw-startupgen
	@test -f stage/usr/lib/ngfw/api/dist/main.js
	@test -f stage/usr/share/ngfw/web/index.html

override_dh_auto_build:

override_dh_auto_test:
	python3 tests/test_packaging.py
	python3 tests/test_firstboot.py
	python3 tests/test_base_policy.py

override_dh_auto_install:

override_dh_gencontrol:
	dh_gencontrol -- -Vngfw:VppVersion=$$(cat stage/VPP_VERSION)

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
