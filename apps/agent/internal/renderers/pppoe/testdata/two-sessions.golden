### /etc/ppp/ipv6-down.d/ngfw-wan0 mode=-rwxr-xr-x
#!/bin/sh
# Rendered PPPoE IPv6 ipv6-down hook. The helper verifies process ownership,
# serializes state publication and returns setup/shutdown failures.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "${PPP_IPPARAM:-}" = "ngfw-wan0" ] || exit 0
iface="${PPP_IFACE:-}"
case "$iface" in ''|*[!A-Za-z0-9_.-]*) exit 0 ;; esac
exec /usr/bin/python3 "/srv/etc/ppp/ngfw-ipv6-wan0" down "$iface" "${LLLOCAL:-}" "${LLREMOTE:-}" "${PPPD_PID:-}"

