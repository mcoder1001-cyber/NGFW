        { "description": "bib", "protocol": "tcp", "inside": { "ip": "2001:db8::10", "port": 80 }, "outside": { "ip": "203.0.113.30", "port": 8080 } }
      ],
      "timeouts": { "udp": 300, "tcpEstablished": 7440, "tcpTransitory": 240, "icmp": 60 }
    },
    "nat66": {
      "enabled": false,
