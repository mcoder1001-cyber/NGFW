          type uint32 {
            range "1..4294967295";
          }
          mandatory true;
        }
        leaf eir {
          type uint32 {
            range "0..4294967295";
          }
          description "Two-rate policers only (RFC 2698: peak rate ≥ cir; RFC 4115 / MEF: excess rate)";
        }
        leaf cb {
          type uint64 {
            range "0..9007199254740991";
          }
          mandatory true;
          description "Bytes (kbps) or packets (pps)";
        }
        leaf eb {
          type uint64 {
            range "0..9007199254740991";
          }
          description "Three-colour policers only";
        }
        leaf round {
          type enumeration {
            enum "closest";
            enum "up";
            enum "down";
          }
          default "closest";
          description "How the engine rounds the configured rate onto its token-bucket parameters";
        }
        leaf colorAware {
          type boolean;
          default "false";
          description "Honour the colour already recorded on the packet (three-colour policers)";
        }
