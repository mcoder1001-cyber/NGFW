module ngfw-routing {
  yang-version 1.1;
  namespace "urn:ngfw:routing";
  prefix ngfw-routing;

  organization "NGFW";
  contact "https://ngfw.dev";
  description "Configuration of the 'routing' domain, generated from the NGFW Zod schema (F-restconf-yang).";

  revision 2026-01-01 {
    description "Generated from the NGFW schema.";
  }

  container routing {
    description "Static routes and dynamic routing protocols (FRR).";
    list static {
      key "vrf prefix";
      leaf prefix {
        type union {
          type string {
            pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])/([0-9]|[1-2][0-9]|3[0-2])";
          }
          type string {
            pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9])";
          }
        }
        mandatory true;
        description "network prefix, e.g. 0.0.0.0/0 or 2001:db8::/32";
      }
      leaf vrf {
        type string {
          pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
          length "1..63";
        }
        default "default";
        description "routing table this object belongs to; `default` is table 0";
      }
      list nextHops {
        // keyless: no itemKey meta — config lists need a key (documented deviation, RESTCONF orders by index)
        ordered-by user;
        description "more than one = equal-cost multipath; empty only for a blackhole route";
        leaf address {
          type union {
            type string {
              pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
            }
            type string {
              pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
            }
          }
          description "gateway address; may be omitted for a directly connected (interface) route";
        }
        leaf interface {
          type string {
            pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
            length "1..63";
          }
          description "egress interface; required when no address is given";
        }
        leaf weight {
          type uint32 {
            range "1..255";
          }
          default "1";
          description "relative share for equal-cost multipath";
        }
        leaf vrf {
          type string {
            pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
            length "1..63";
          }
          description "resolve the next-hop address in this VRF (default: the route’s VRF)";
        }
      }
      leaf blackhole {
        type boolean;
        default "false";
        description "silently drop matching traffic (null route); requires an empty next-hop list";
      }
      leaf distance {
        type uint32 {
          range "1..255";
        }
        default "1";
        description "administrative distance (1–255)";
      }
      leaf description {
        type string {
          // pattern dropped: not XSD-expressible
          length "0..255";
        }
      }
      leaf viaFrr {
        type boolean;
        description "hand this route to FRR (staticd) instead of programming it in the engine directly, e.g. to redistribute it";
      }
      leaf tag {
        type uint32 {
          range "1..4294967295";
        }
        description "tag carried into routing protocols on redistribution (FRR routes only, see Program via FRR)";
      }
    }
    container policy {
      description "prefix lists and route maps";
      list prefixLists {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf description {
          type string {
            // pattern dropped: not XSD-expressible
            length "0..255";
          }
        }
        leaf family {
          type enumeration {
            enum "ipv4";
            enum "ipv6";
          }
          default "ipv4";
          description "ip (IPv4) or ipv6 prefix-list";
        }
        list rules {
          key "seq";
          leaf seq {
            type uint32 {
              range "1..4294967295";
            }
            mandatory true;
          }
          leaf action {
            type enumeration {
              enum "permit";
              enum "deny";
            }
            mandatory true;
          }
          leaf prefix {
            type union {
              type string {
                pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])/([0-9]|[1-2][0-9]|3[0-2])";
              }
              type string {
                pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/(12[0-8]|1[01][0-9]|[1-9]?[0-9])";
              }
            }
            mandatory true;
          }
          leaf ge {
            type uint32 {
              range "1..128";
            }
            description "match prefixes at least this long (longer than the prefix itself)";
          }
          leaf le {
            type uint32 {
              range "0..128";
            }
            description "match prefixes at most this long";
          }
        }
      }
      list routeMaps {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf description {
          type string {
            // pattern dropped: not XSD-expressible
            length "0..255";
          }
        }
        list entries {
          key "seq";
          leaf seq {
            type uint32 {
              range "1..4294967295";
            }
            mandatory true;
          }
          leaf action {
            type enumeration {
              enum "permit";
              enum "deny";
            }
            mandatory true;
          }
          leaf description {
            type string {
              // pattern dropped: not XSD-expressible
              length "0..255";
            }
          }
          container match {
            description "all given conditions must match; an empty match matches everything";
            leaf prefixList {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
              description "match the destination prefix against a prefix list";
            }
            leaf nextHopPrefixList {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
              description "match the next hop against a prefix list";
            }
            leaf interface {
              type string {
                pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
                length "1..63";
              }
            }
            leaf community {
              type string {
                pattern "((0|[1-9][0-9]{0,4}):(0|[1-9][0-9]{0,4})|internet|no-export|no-advertise|local-AS)";
              }
            }
            leaf asPath {
              type string {
                // pattern dropped: not XSD-expressible
                length "1..255";
              }
              description "FRR as-path regular expression, e.g. ^65000_";
            }
            leaf metric {
              type uint32 {
                range "0..4294967295";
              }
            }
            leaf tag {
              type uint32 {
                range "0..4294967295";
              }
            }
          }
          container set {
            leaf localPref {
              type uint32 {
                range "0..4294967295";
              }
            }
            leaf med {
              type uint32 {
                range "0..4294967295";
              }
              description "BGP multi-exit discriminator (FRR `set metric`)";
            }
            leaf weight {
              type uint32 {
                range "0..65535";
              }
            }
            leaf nextHop {
              type union {
                type string {
                  pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
                }
                type string {
                  pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
                }
              }
            }
            leaf-list community {
              type string {
                pattern "((0|[1-9][0-9]{0,4}):(0|[1-9][0-9]{0,4})|internet|no-export|no-advertise|local-AS)";
              }
            }
            leaf communityAdditive {
              type boolean;
              default "false";
              description "append the communities instead of replacing them";
            }
            leaf-list asPathPrepend {
              type uint32 {
                range "1..4294967295";
              }
            }
            leaf tag {
              type uint32 {
                range "0..4294967295";
              }
            }
          }
        }
      }
    }
    container bgp {
      leaf asn {
        type uint32 {
          range "1..4294967295";
        }
        mandatory true;
        description "asplain, e.g. 65000 or 4200000000";
      }
      leaf routerId {
        type string {
          pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
        }
        description "dotted quad, e.g. 10.255.0.1";
      }
      leaf vrf {
        type string {
          pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
          length "1..63";
        }
        default "default";
        description "routing table this object belongs to; `default` is table 0";
      }
      list peerGroups {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf remoteAs {
          type uint32 {
            range "1..4294967295";
          }
          description "asplain, e.g. 65000 or 4200000000";
        }
        leaf description {
          type string {
            // pattern dropped: not XSD-expressible
            length "0..255";
          }
        }
        leaf updateSource {
          type union {
            type union {
              type string {
                pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
              }
              type string {
                pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
              }
            }
            type string {
              pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
              length "1..63";
            }
          }
          description "local address or interface for the session";
        }
        leaf ebgpMultihop {
          type uint32 {
            range "1..255";
          }
          description "TTL for eBGP sessions that are not directly connected";
        }
        leaf passwordRef {
          type string {
            pattern "(password)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "0..127";
          }
          description "TCP MD5 session password in the secret store, e.g. password/bgp-upstream";
        }
        leaf keepaliveSec {
          type uint32 {
            range "1..65535";
          }
        }
        leaf holdTimeSec {
          type uint32 {
            range "3..65535";
          }
        }
        leaf bfd {
          type boolean;
          default "false";
          description "fast failure detection";
        }
        container afi {
          container ipv4Unicast {
            leaf enabled {
              type boolean;
              default "true";
            }
            leaf routeMapIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf routeMapOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf nextHopSelf {
              type boolean;
              default "false";
            }
            leaf softReconfig {
              type boolean;
              default "false";
              description "keep an unmodified copy of received routes so policy changes apply without a session reset";
            }
            leaf maximumPrefixes {
              type uint32 {
                range "1..4294967295";
              }
              description "tear the session down above this many prefixes";
            }
            leaf defaultOriginate {
              type boolean;
              default "false";
            }
          }
          container ipv6Unicast {
            leaf enabled {
              type boolean;
              default "true";
            }
            leaf routeMapIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf routeMapOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf nextHopSelf {
              type boolean;
              default "false";
            }
            leaf softReconfig {
              type boolean;
              default "false";
              description "keep an unmodified copy of received routes so policy changes apply without a session reset";
            }
            leaf maximumPrefixes {
              type uint32 {
                range "1..4294967295";
              }
              description "tear the session down above this many prefixes";
            }
            leaf defaultOriginate {
              type boolean;
              default "false";
            }
          }
        }
      }
      list neighbors {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        description "keyed by neighbour address, e.g. 10.0.0.1 or 2001:db8::1";
        leaf peerGroup {
          type string {
            pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
            length "1..63";
          }
          description "inherit settings from this peer group";
        }
        leaf shutdown {
          type boolean;
          default "false";
          description "keep the configuration but do not bring the session up";
        }
        leaf remoteAs {
          type uint32 {
            range "1..4294967295";
          }
          description "asplain, e.g. 65000 or 4200000000";
        }
        leaf description {
          type string {
            // pattern dropped: not XSD-expressible
            length "0..255";
          }
        }
        leaf updateSource {
          type union {
            type union {
              type string {
                pattern "((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])";
              }
              type string {
                pattern "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
              }
            }
            type string {
              pattern "[A-Za-z][A-Za-z0-9_-]*(/[0-9a-fA-F]+)*(\\.[0-9]+)?";
              length "1..63";
            }
          }
          description "local address or interface for the session";
        }
        leaf ebgpMultihop {
          type uint32 {
            range "1..255";
          }
          description "TTL for eBGP sessions that are not directly connected";
        }
        leaf passwordRef {
          type string {
            pattern "(password)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "0..127";
          }
          description "TCP MD5 session password in the secret store, e.g. password/bgp-upstream";
        }
        leaf keepaliveSec {
          type uint32 {
            range "1..65535";
          }
        }
        leaf holdTimeSec {
          type uint32 {
            range "3..65535";
          }
        }
        leaf bfd {
          type boolean;
          default "false";
          description "fast failure detection";
        }
        container afi {
          container ipv4Unicast {
            leaf enabled {
              type boolean;
              default "true";
            }
            leaf routeMapIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf routeMapOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf nextHopSelf {
              type boolean;
              default "false";
            }
            leaf softReconfig {
              type boolean;
              default "false";
              description "keep an unmodified copy of received routes so policy changes apply without a session reset";
            }
            leaf maximumPrefixes {
              type uint32 {
                range "1..4294967295";
              }
              description "tear the session down above this many prefixes";
            }
            leaf defaultOriginate {
              type boolean;
              default "false";
            }
          }
          container ipv6Unicast {
            leaf enabled {
              type boolean;
              default "true";
            }
            leaf routeMapIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf routeMapOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListIn {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf prefixListOut {
              type string {
                pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
                length "1..63";
              }
            }
            leaf nextHopSelf {
              type boolean;
              default "false";
            }
            leaf softReconfig {
              type boolean;
              default "false";
              description "keep an unmodified copy of received routes so policy changes apply without a session reset";
            }
            leaf maximumPrefixes {
              type uint32 {
                range "1..4294967295";
              }
              description "tear the session down above this many prefixes";
            }
            leaf defaultOriginate {
              type boolean;
              default "false";
            }
          }
        }
      }
      list networks {
        key "prefix";
        description "prefixes originated by this router";
        leaf prefix {
          type union {
            type string {
