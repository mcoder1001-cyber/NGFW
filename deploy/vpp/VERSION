# deploy/vpp/VERSION — the pinned upstream VPP source the product ships (WBS D0.2, F-vpp-debs).
# Data, not code: KEY=VALUE lines parsed by lib.sh (vrx_parse_version, strict per-key formats), never sourced. Bump: README.md.
VPP_UPSTREAM_URL=https://gerrit.fd.io/r/vpp
VPP_BRANCH=stable/2606
VPP_TAG=v26.06
# annotated tag object and the commit it points to (git rev-parse v26.06 / v26.06^{commit}); both are verified before building
VPP_TAG_OBJECT=29c51fb8b95a92d0d325cff2e502549e652aad9f
VPP_COMMIT=c3200b88dc46bd380f00a49ca3392a102cc1980b
# Debian version of an UNPATCHED build (src/scripts/version on the exact tag → "<tag>-release"; same as vrx-a today)
VPP_DEB_VERSION=26.06-release
# D-089: any build with a non-empty applied patch series (product, --demo or optional patches) is versioned
# "<VPP_DEB_VERSION>+vrx<VPP_LOCAL_REV>". Bump VPP_LOCAL_REV whenever the product series changes.
VPP_LOCAL_REV=1
# the package set `make pkg-deb` produces for this tag on Ubuntu 26.04 amd64 (same set as /root/vpp/build-root/*.deb on vrx-a)
VPP_PACKAGES="libvppinfra libvppinfra-dev python3-vpp-api vpp vpp-crypto-engines vpp-dbg vpp-dev vpp-drivers vpp-plugin-core vpp-plugin-devtools vpp-plugin-dpdk"
# the subset installed on vrx-a today (docs/lab/host-vrx-a.md); the rest are built but not installed
VPP_PACKAGES_INSTALLED="libvppinfra python3-vpp-api vpp vpp-crypto-engines vpp-drivers vpp-plugin-core vpp-plugin-dpdk"
# D-089: what the product ships (vrx-meta / ISO); neither vpp-dbg nor vpp-dev (nor libvppinfra-dev, vpp-plugin-devtools)
VPP_PACKAGES_SHIP="libvppinfra python3-vpp-api vpp vpp-crypto-engines vpp-drivers vpp-plugin-core vpp-plugin-dpdk"
