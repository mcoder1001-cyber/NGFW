{{- /* VPP startup.conf. Every user string passes a validator in model.go/validate.go AND a
       template helper below (ident / pathtok); numbers are rendered raw. */ -}}
# Generated by ngfw-startupgen from the `dataplane` domain of the NGFW configuration.
# Do not edit by hand: changes need a VPP restart, applied by the manager procedure in
# docs/agent/renderers/vppstartup.md.
{{- if .M.HugepagesGB}}
# hugepages: {{.M.HugepagesGB}} GiB of 2 MB pages, reserved by the host (vm.nr_hugepages), not by this file.
{{- end}}

unix {
  nodaemon
{{- if .S.RuntimeDir}}
  runtime-dir {{pathtok .S.RuntimeDir}}
{{- end}}
  log {{pathtok .S.LogFile}}
  full-coredump
  cli-listen {{pathtok .S.CLISocket}}
{{- if .S.PollSleepUsec}}
  poll-sleep-usec {{.S.PollSleepUsec}}
{{- end}}
  gid {{ident .S.Group}}
}

api-trace {
  on
}

api-segment {
{{- if .S.APIPrefix}}
  prefix {{ident .S.APIPrefix}}
{{- end}}
  gid {{ident .S.Group}}
}

socksvr {
{{- if .S.APISocket}}
  socket-name {{pathtok .S.APISocket}}
{{- else}}
  default
{{- end}}
}

statseg {
  socket-name {{pathtok .S.StatsSocket}}
{{- if .S.StatsegMB}}
  size {{.S.StatsegMB}}M
{{- end}}
}
{{- if .S.MainHeapMB}}

memory {
  main-heap-size {{.S.MainHeapMB}}M
{{- if .S.MainHeapPageSize}}
  main-heap-page-size {{ident .S.MainHeapPageSize}}
{{- end}}
}
{{- end}}

cpu {
  main-core {{.M.MainCore}}
{{- if .M.Corelist}}
  corelist-workers {{.M.Corelist}}
{{- end}}
}
{{- if or .M.BuffersPerNuma .S.BuffersPageSize}}

buffers {
{{- if .M.BuffersPerNuma}}
  buffers-per-numa {{.M.BuffersPerNuma}}
{{- end}}
{{- if .S.BuffersPageSize}}
  page-size {{ident .S.BuffersPageSize}}
{{- end}}
}
{{- end}}
{{- if .M.DPDK}}

dpdk {
{{- if .M.HasDefaultQueues}}
  dev default {
{{- if .M.RxQueues}}
    num-rx-queues {{.M.RxQueues}}
{{- end}}
{{- if .M.TxQueues}}
    num-tx-queues {{.M.TxQueues}}
{{- end}}
  }
{{- end}}
{{- range .M.Devices}}
{{- if .HasBlock}}
  dev {{ident .PCI}} {
{{- if .Name}}
    name {{ident .Name}}
{{- end}}
{{- if .RxQueues}}
    num-rx-queues {{.RxQueues}}
{{- end}}
{{- if .TxQueues}}
    num-tx-queues {{.TxQueues}}
{{- end}}
{{- if .RxDesc}}
    num-rx-desc {{.RxDesc}}
{{- end}}
{{- if .TxDesc}}
    num-tx-desc {{.TxDesc}}
{{- end}}
  }
{{- else}}
  dev {{ident .PCI}}
{{- end}}
{{- end}}
{{- if .M.Blacklist}}
  # host management NIC(s): never handed to DPDK
{{- end}}
{{- range .M.Blacklist}}
  blacklist {{ident .}}
{{- end}}
{{- if not .M.Devices}}
  # no DPDK devices configured: probe no PCI device at all
  no-pci
{{- end}}
}
{{- end}}
{{- if .M.Plugins}}

plugins {
{{- range .M.Plugins}}
  plugin {{ident .File}} { {{if .Enable}}enable{{else}}disable{{end}} }
{{- end}}
}
{{- end}}
