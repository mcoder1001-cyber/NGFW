{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "TodoWrite",
      "TodoRead",
      "ToolSearch"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git push --force*)"
    ]
  }
}
