+// startISP6 serves IPv6 on the ISP side of the current session (test tools, see the file comment): it finds the ISP
+// pppd's interface in ns-<p>-wan, gives it a global /128 plus a route back to the RA prefix (a ping target), turns on
+// forwarding there (so the all-routers group is joined and the client's RS is heard), and starts ra.py (+ dhcp6s.py).
+func (e *pplEnv) startISP6() string {
+	e.stopISP6()
+	ns := "ns-" + e.prefix + "-wan"
+	sif := ""
+	for i := 0; i < 40 && sif == ""; i++ {
+		out, _ := e.cmd("ip", "-n", ns, "-o", "link", "show", "type", "ppp")
+		for _, l := range strings.Split(out, "\n") {
+			if f := strings.SplitN(l, ": ", 3); len(f) >= 2 && sif == "" {
+				sif = strings.TrimSpace(strings.SplitN(f[1], "@", 2)[0])
+			}
+		}
+		if sif == "" {
+			time.Sleep(250 * time.Millisecond)
+		}
+	}
+	if sif == "" {
+		e.t.Logf("ISP6: no ppp interface in %s", ns)
+		return ""
+	}
+	pfx := fmt.Sprintf("2001:db8:%d::", e.slot)
+	for _, c := range [][]string{{"ip", "netns", "exec", ns, "sysctl", "-qw", "net.ipv6.conf.all.forwarding=1"},
+		{"ip", "-n", ns, "-6", "addr", "add", pfx + "1/128", "dev", sif}, {"ip", "-n", ns, "-6", "route", "replace", pfx + "/64", "dev", sif}} {
+		if out, err := e.cmd(c[0], c[1:]...); err != nil {
+			e.t.Logf("ISP6 %v: %v %s", c, err, out)
+		}
+	}
+	args := [][]string{{"python3", filepath.Join(e.tools, "ra.py"), sif, pfx + "/64"}}
+	if e.ipv6 == "dhcpv6" {
+		args[0] = append(args[0], "managed")
+		args = append(args, []string{"python3", filepath.Join(e.tools, "dhcp6s.py"), sif, pfx + "100", fmt.Sprintf("2001:db8:%d00::/56", e.slot)})
+	}
+	for _, a := range args {
+		cmd := exec.Command("ip", append([]string{"netns", "exec", ns}, a...)...) //nolint:gosec // fixed test tools
+		cmd.Env = append(os.Environ(), "RA_PERIOD=10")
+		f, _ := os.OpenFile(filepath.Join(e.tmp, filepath.Base(a[1])+".log"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+		cmd.Stdout, cmd.Stderr = f, f
+		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+		if err := cmd.Start(); err != nil {
+			e.t.Logf("ISP6 start %v: %v", a, err)
+			continue
+		}
+		e.isp6 = append(e.isp6, cmd)
+		go func() { _ = cmd.Wait(); _ = f.Close() }()
+	}
+	e.t.Logf("ISP6: serving %s/64 on %s in %s (mode %s)", pfx, sif, ns, e.ipv6)
+	return sif
+}
+
+func (e *pplEnv) stopISP6() {
+	for _, c := range e.isp6 {
+		if c.Process != nil {
+			_ = syscall.Kill(-c.Process.Pid, syscall.SIGKILL)
+		}
+	}
+	e.isp6 = nil
+}
+
+// mirror6 reports what VPP holds for the IPv6 side: the /128s on w0 and whether ::/0 in the table has a path via a
+// link-local router out w0.
+func (e *pplEnv) mirror6() (addrs []string, route bool) {
+	for _, f := range strings.Fields(e.vppctl("show", "interface", "address", "host-"+e.prefix+"w0")) {
+		if strings.HasPrefix(f, "2001:db8:") && strings.HasSuffix(f, "/128") {
+			addrs = append(addrs, f)
+		}
+	}
+	fib := e.vppctl("show", "ip6", "fib", "table", strconv.Itoa(int(e.table)), "::/0")
+	route = strings.Contains(fib, "fe80::") && strings.Contains(fib, "host-"+e.prefix+"w0")
+	return addrs, route
+}
+
+// want6 is the /128 set the agent should mirror for a reported ipv6 summary ("a/64, b/128, delegated p/56").
+func want6(summary string) []string {
+	var out []string
+	for _, part := range strings.Split(summary, ", ") {
+		if part == "" || strings.HasPrefix(part, "delegated ") {
+			continue
+		}
+		out = append(out, strings.SplitN(part, "/", 2)[0]+"/128")
+	}
+	return out
+}
+
+func sameSet(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	m := map[string]bool{}
+	for _, x := range a {
+		m[x] = true
+	}
+	for _, x := range b {
+		if !m[x] {
+			return false
+		}
+	}
+	return true
+}
+
+// waitIPv6 waits for the agent to report IPv6 (with the delegated prefix in dhcpv6 mode) and for VPP to hold exactly
+// that mirror; it returns the state, the VPP view and how long it took.
+func (e *pplEnv) waitIPv6(within time.Duration) (*ngfwv1.PppoeSessionState, []string, bool, time.Duration) {
+	start := time.Now()
+	var st *ngfwv1.PppoeSessionState
+	var addrs []string
+	var route bool
+	for time.Since(start) < within {
+		st = e.state()
+		ok := st.GetIpv6() != "" && (e.ipv6 != "dhcpv6" || (strings.Contains(st.GetIpv6(), "delegated ") && len(want6(st.GetIpv6())) >= 2))
+		if ok {
+			addrs, route = e.mirror6()
+			if route && sameSet(addrs, want6(st.GetIpv6())) {
+				return st, addrs, route, time.Since(start)
+			}
+		}
+		time.Sleep(500 * time.Millisecond)
+	}
+	addrs, route = e.mirror6()
+	return st, addrs, route, -1
+}
