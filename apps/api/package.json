{
  "name": "@ngfw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "echo 'api: nothing to generate'",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "openapi": "tsc -p tsconfig.build.json && node dist/openapi.js ../../packages/api-client/openapi.json",
    "test:e2e": "vitest run -c vitest.e2e.config.ts test/e2e",
    "test:integration": "vitest run -c vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.1",
    "@grpc/grpc-js": "^1.14.5",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-fastify": "^11",
    "@nestjs/swagger": "^11",
    "@ngfw/proto": "workspace:*",
    "@ngfw/schema": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@swc/core": "^1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4",
    "typescript": "^5.6",
    "unplugin-swc": "^1",
    "vitest": "^3"
  }
}
