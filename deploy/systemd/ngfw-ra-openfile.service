[Unit]
Description=NGFW fixed remote-access supplier configuration publisher
StartLimitIntervalSec=10
StartLimitBurst=64

[Service]
Type=exec
User=root
Group=ngfw
ExecStart=/usr/lib/ngfw/ngfw-ra-namespace-broker --publish-openfile
OpenFile=/run/ngfw/ra/source-agent-exe:source-agent-exe:read-only
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/run/systemd/system
RuntimeMaxSec=10
TimeoutStartSec=5
TimeoutStopSec=2
StandardOutput=null
StandardError=null
