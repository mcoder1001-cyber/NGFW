# Rendered by vrx-agent (snmpd renderer). Do not edit: every commit overwrites this file.
# Holds SNMP communities and USM passphrases: mode 0600.
agentaddress udp:127.0.0.1:3861,udp6:[::1]:3861,udp:10.8.0.1:161
dontLogTCPWrappersConnects yes
exactEngineID 0x800007e5804a1b2c3d
sysName vrx-w8
sysLocation Rack 4, Hall B
sysContact noc@example.net
sysServices 78

# views
view vrx_all included .1
view all2 included .1
view ifs included .1.3.6.1.2.1.1
view ifs included .1.3.6.1.2.1.2
view ifs included .1.3.6.1.2.1.31
view ifs included .1.3.6.1.4.1.2021.10
view ifs excluded .1.3.6.1.2.1.1.9

# SNMPv1/v2c communities
rocommunity VRX_TEST_PSK_RF4_ro 127.0.0.1/32 -V ifs

# SNMPv3 USM users
createUser u1 SHA-256 "VRX_TEST_PSK_RF4_auth" AES "VRX_TEST_PSK_RF4_priv"
rouser u1 priv -V ifs

# AgentX master for the private-MIB subagent (F-snmp)
master agentx
agentXSocket unix:/run/vrx-test/w0/snmpd/agentx.sock
agentXPerms 0600 0700

# monitors
disk / 10%
disk /var/log 20%
load 12 10 8
