# Rendered by vrx-agent (keepalived renderer). Do not edit: every commit overwrites this file.
global_defs {
    router_id vrx
    enable_script_security
    script_user root
    vrrp_version 3
}

vrrp_instance a {
    state BACKUP
    interface w0-a
    virtual_router_id 91
    priority 100
    advert_int 1
    version 2
    virtual_ipaddress {
        10.0.240.1/32 dev w0-a
    }
    authentication {
        auth_type PASS
        auth_pass RF4tpskA
    }
    notify_master "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE a MASTER"
    notify_backup "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE a BACKUP"
    notify_fault "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE a FAULT"
    notify_stop "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE a STOP"
}

vrrp_instance b {
    state BACKUP
    interface w0-b
    virtual_router_id 92
    priority 100
    advert_int 2
    version 2
    virtual_ipaddress {
        10.0.240.1/32 dev w0-b
    }
    authentication {
        auth_type PASS
        auth_pass RF4tpskB
    }
    notify_master "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE b MASTER"
    notify_backup "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE b BACKUP"
    notify_fault "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE b FAULT"
    notify_stop "/opt/vrx-test/bin/vrx-keepalived-notify /run/vrx-test/w0/keepalived/state INSTANCE b STOP"
}
