{
  "name": "@ngfw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "echo 'api: nothing to generate'",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "openapi": "tsc -p tsconfig.build.json && node dist/openapi.js ../../packages/api-client/openapi.json"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-fastify": "^11",
    "@nestjs/swagger": "^11",
    "@ngfw/proto": "workspace:*",
    "@ngfw/schema": "workspace:*",
    "fastify": "^5",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@swc/core": "^1",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.6",
    "unplugin-swc": "^1",
    "vitest": "^3"
  }
}
