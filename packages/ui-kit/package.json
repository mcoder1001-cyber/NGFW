    "i18next": "^25",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^15"
  },
  "devDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@tanstack/react-query": "^5",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "eslint-plugin-i18next": "^6",
    "i18next": "^25",
    "jsdom": "^26",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^15",
