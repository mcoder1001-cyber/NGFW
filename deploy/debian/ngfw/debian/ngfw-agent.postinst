#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    getent group ngfw >/dev/null || addgroup --system ngfw
    getent passwd ngfw >/dev/null || adduser --system --ingroup ngfw --home /var/lib/ngfw --no-create-home ngfw
    install -d -m 0750 -o root -g ngfw /var/lib/ngfw/agent /etc/ngfw
    install -d -m 0700 -o root -g root /var/lib/ngfw/captures
    install -d -m 0750 -o root -g root /etc/ngfw/rsyslog-tls
    /usr/bin/python3 /usr/lib/ngfw/provision-system-identity.py
fi
#DEBHELPER#
