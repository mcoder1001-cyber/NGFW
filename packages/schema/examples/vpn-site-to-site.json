{
  "system": { "hostname": "vrx-a" },
  "vrfs": {
    "default": { "id": 0, "description": "global routing table" },
    "customer-a": { "id": 10, "description": "customer A" }
  },
  "interfaces": {
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "description": "uplink",
      "mtu": 1500,
      "ipv4": ["198.51.100.2/30"],
      "ipv6": ["2001:db8:0:1::2/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "description": "lan",
      "mtu": 1500,
      "ipv4": ["192.168.10.1/24"],
      "ipv6": ["2001:db8:10::1/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/2": {
      "enabled": true,
      "description": "customer A access",
      "mtu": 1500,
      "ipv4": ["10.20.0.1/24"],
      "vrf": "customer-a",
      "rxMode": "polling"
    }
  },
  "tunnels": {
    "ipip": {
      "ipip-site-b": {
        "instance": 0,
        "src": "198.51.100.2",
        "dst": "203.0.113.10",
        "underlayVrf": "default",
        "vrf": "default",
        "ipv4": ["10.255.0.1/30"]
      },
      "ipip-hub": {
        "instance": 1,
        "mode": "p2mp",
        "src": "198.51.100.2",
        "underlayVrf": "default",
        "vrf": "default"
      }
    }
  },
  "vpn": {
    "ipsec": {
      "settings": { "cryptoEngine": "auto", "asyncCrypto": false },
      "proposals": {
        "ike2-aes256gcm": {
          "description": "IKEv2 AEAD suite",
          "ike": { "encr": "aes256gcm16", "prf": "prfsha384", "dh": "ecp256" },
          "esp": { "encr": "aes256gcm16", "dh": "ecp256" }
        },
        "legacy-aes256-sha256": {
          "ike": { "encr": "aes256", "integ": "sha256", "dh": "modp2048" },
          "esp": { "encr": "aes256", "integ": "sha256" }
        }
      },
      "tunnels": {
        "site-b": {
          "description": "route-based tunnel to site B",
          "ikeVersion": 2,
          "localAddr": "198.51.100.2",
          "remoteAddr": "203.0.113.10",
          "localId": "vrx-a.lab.example",
          "remoteId": "vrx-b.lab.example",
          "auth": { "method": "psk", "secretRef": "psk/site-b" },
          "proposal": "ike2-aes256gcm",
          "dpd": { "enabled": true, "delaySec": 30, "action": "restart" },
          "rekey": { "ikeSec": 14400, "espSec": 3600 },
          "startAction": "start",
          "vrf": "default",
          "routeBased": { "ipipInterface": "ipip-site-b" }
        },
        "hub-any": {
          "description": "responder-only, route-based, many spokes",
          "localAddr": "198.51.100.2",
          "remoteAddr": "%any",
          "localId": "vrx-a.lab.example",
          "auth": { "method": "psk", "secretRef": "psk/spokes" },
          "proposal": "ike2-aes256gcm",
          "startAction": "trap",
          "vrf": "default",
          "routeBased": { "ipipInterface": "ipip-hub" }
        },
        "legacy-policy": {
          "ikeVersion": 1,
          "localAddr": "198.51.100.2",
          "remoteAddr": "203.0.113.11",
          "auth": { "method": "psk", "secretRef": "psk/legacy" },
          "proposal": "legacy-aes256-sha256",
          "localTs": ["192.168.10.0/24"],
          "remoteTs": ["10.99.0.0/16"],
          "natT": true,
          "vrf": "default"
        }
      }
    }
  }
}
