{
  "interfaces": {
    "TenGigabitEthernet0/0/0": { "description": "WAN", "vrf": "default" },
    "TenGigabitEthernet0/0/1": {
      "description": "LAN",
      "vrf": "default",
      "subinterfaces": { "100": { "vlanId": 100 } }
    }
  },
  "objects": {
    "tags": { "prod": { "description": "production", "color": "#1e88e5" }, "dmz": {} },
    "addresses": {
      "web-1": { "type": "host", "address": "10.0.10.11", "tags": ["prod"] },
      "web-2": { "type": "host", "address": "10.0.10.12", "tags": ["prod"] },
      "lan": { "type": "network", "prefix": "192.168.1.0/24" },
      "lan6": { "type": "network", "prefix": "2001:db8:1::/64" },
      "printers": { "type": "range", "start": "192.168.1.200", "end": "192.168.1.220" },
      "updates": {
        "type": "fqdn",
        "fqdn": "updates.example.net",
        "description": "vendor update servers"
      }
    },
    "addressGroups": {
      "web-servers": { "members": ["web-1", "web-2"], "tags": ["prod", "dmz"] },
      "internal": { "members": ["lan", "lan6", "printers"] }
    },
    "services": {
      "http": { "protocol": "tcp", "destinationPorts": ["80"] },
      "https": {
        "protocol": "tcp",
        "destinationPorts": ["443"],
        "tcpFlags": { "mask": 18, "value": 2 }
      },
      "dns": { "protocol": "tcp-udp", "destinationPorts": ["53"] },
      "ping": { "protocol": "icmp", "type": 8, "code": 0 },
      "ping6": { "protocol": "icmp6", "type": 128 },
      "gre": { "protocol": "other", "number": 47 },
      "all-ip": { "protocol": "any" },
      "sip": {
        "protocol": "udp",
        "destinationPorts": ["5060-5061", "10000-20000"],
        "sourcePorts": ["1024-65535"]
      }
    },
    "serviceGroups": {
      "web": { "members": ["http", "https"] },
      "infra": { "members": ["dns", "ping", "ping6"] }
    },
    "schedules": {
      "business-hours": {
        "type": "recurring",
        "days": ["mon", "tue", "wed", "thu", "fri"],
        "start": "08:00",
        "end": "18:00"
      },
      "maintenance": {
        "type": "once",
        "start": "2026-10-03T22:00:00+03:30",
        "end": "2026-10-04T02:00:00+03:30"
      }
    },
    "zones": {
      "lan": { "interfaces": ["TenGigabitEthernet0/0/1", "TenGigabitEthernet0/0/1.100"] },
      "wan": { "interfaces": ["TenGigabitEthernet0/0/0"] }
    }
  }
}
