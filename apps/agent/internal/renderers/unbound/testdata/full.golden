# Generated by vrx-agent (RF-3 unbound renderer). Do not edit: the next commit overwrites it.
# vrx-input: 
# resolver "lan": "LAN resolver"
server:
	directory: "/run/vrx-test/w0/unbound"
	chroot: ""
	username: ""
	pidfile: "/run/vrx-test/w0/unbound/unbound.pid"
	do-daemonize: no
	use-syslog: no
	logfile: "/run/vrx-test/w0/unbound/unbound.log"
	verbosity: 1
	port: 3653
	interface: 127.0.0.1@3653
	interface: ::1@3653
	num-threads: 2
	msg-cache-size: 16m
	rrset-cache-size: 32m
	cache-min-ttl: 30
	cache-max-ttl: 3600
	prefetch: yes
	qname-minimisation: yes
	hide-identity: yes
	hide-version: no
	log-queries: yes
	harden-glue: yes
	harden-below-nxdomain: yes
	harden-dnssec-stripped: yes
	access-control: 10.6.0.0/16 allow
	access-control: 127.0.0.0/8 allow
	access-control: ::1/128 allow_snoop
	auto-trust-anchor-file: "/run/vrx-test/w0/unbound/root.key"
	tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"
	local-zone: "6.10.in-addr.arpa." transparent
	local-data: '1.0.6.10.in-addr.arpa. 3600 IN PTR gw.lan.example.test.'
	local-zone: "blocked.test." refuse
	local-zone: "lan.example.test." static
	local-data: 'gw.lan.example.test. 3600 IN A 10.6.0.1'
	local-data: 'gw.lan.example.test. 3600 IN AAAA fd00:6::1'
	local-data: 'www.lan.example.test. 3600 IN CNAME gw.lan.example.test.'
	local-data: 'lan.example.test. 3600 IN MX 10 mail.lan.example.test.'
	local-data: 'lan.example.test. 3600 IN NS gw.lan.example.test.'
	local-data: '_sip._tcp.lan.example.test. 3600 IN SRV 10 5 5060 sip.lan.example.test.'
	local-data: 'txt.lan.example.test. 60 IN TXT "v=spf1 \034quoted\034 \092 back \059 semi \039apos\039 \105nclude\058 /etc/passwd"'

remote-control:
	control-enable: yes
	control-interface: "/run/vrx-test/w0/unbound/unbound.ctl"
	control-use-cert: no

forward-zone:
	name: "."
	forward-addr: 192.0.2.53@53
	forward-addr: 192.0.2.54@5353
	forward-first: no
	forward-tls-upstream: no

forward-zone:
	name: "corp.example.test."
	forward-addr: 2001:db8::53@853#dns.example.test
	forward-addr: 192.0.2.1@853
	forward-first: yes
	forward-tls-upstream: yes

