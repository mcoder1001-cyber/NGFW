          leaf max1 {
            type uint32 {
              range "1..1000";
            }
            mandatory true;
          }
          leaf max5 {
            type uint32 {
              range "1..1000";
            }
            mandatory true;
          }
          leaf max15 {
            type uint32 {
              range "1..1000";
            }
            mandatory true;
          }
        }
      }
