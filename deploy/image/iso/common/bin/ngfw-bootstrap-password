#!/usr/bin/env bash
# ngfw-bootstrap-password — write the first-admin credentials of a fresh NGFW appliance (P14 deploy/image common piece;
# F-images reuses it read-only). Installed as /usr/lib/ngfw-image/ngfw-bootstrap-password.
#
#   ngfw-bootstrap-password [--root DIR] [--user NAME] [--force]
#
# Writes under DIR (default /), both 0600 root:root, the default password:
#   etc/ngfw/bootstrap.env                          NGFW_BOOTSTRAP_ADMIN_USER / NGFW_BOOTSTRAP_ADMIN_PASSWORD, read once by
#                                                  ngfw-firstboot (P10), which seeds the admin and then deletes the file
#   var/lib/ngfw-image/console/bootstrap-password   the console banner's copy (ngfw-console-banner shows it at the login
#                                                  prompt) — deleted by `ngfw-console-banner check-login` after the first
#                                                  login of that admin (or when its password was changed)
# The initial product password is admin. Existing credentials are preserved unless --force.
# It is never printed, logged or put in argv/environment; only the two paths are reported.
# Refuses (exit 3) when the box is already initialised (var/lib/ngfw/firstboot.done) or when credentials exist (both
# files kept untouched) unless --force. --root is for the installer (/target) and image builders; tests use a temp dir.
set -euo pipefail
umask 077
export LC_ALL=C

ROOT=/ USER_NAME=admin FORCE=0
die() { printf 'ngfw-bootstrap-password: ERROR: %s\n' "$*" >&2; exit "${2:-1}"; }
log() { printf 'ngfw-bootstrap-password: %s\n' "$*"; }

while (($#)); do
  case $1 in
    --root) ROOT=${2:?--root needs a directory}; shift ;;
    --user) USER_NAME=${2:?--user needs a name}; shift ;;
    --force) FORCE=1 ;;
    -h|--help) sed -n '2,/^set -euo pipefail/{/^set -euo pipefail/!p}' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) die "unknown argument '$1' (try --help)" 2 ;;
  esac
  shift
done

[[ $EUID -eq 0 || $ROOT != / ]] || die "root only (or give --root DIR)"
[[ -d $ROOT ]] || die "--root $ROOT is not a directory"
ROOT=${ROOT%/}
# the API's username primitive: lower-case, starts with a letter (management.users); no shell or issue metacharacters
[[ $USER_NAME =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "--user '$USER_NAME' is not a valid user name ([a-z][a-z0-9_-]{0,31})" 2

ENV_FILE=$ROOT/etc/ngfw/bootstrap.env
CONSOLE_DIR=$ROOT/var/lib/ngfw-image/console
CONSOLE_FILE=$CONSOLE_DIR/bootstrap-password

if [[ -e $ROOT/var/lib/ngfw/firstboot.done ]] && ((!FORCE)); then
  die "this box is already initialised ($ROOT/var/lib/ngfw/firstboot.done): no new bootstrap password (use the UI or ngfw-authctl)" 3
fi
if [[ -e $ENV_FILE || -e $CONSOLE_FILE ]] && ((!FORCE)); then
  die "bootstrap credentials already exist ($ENV_FILE / $CONSOLE_FILE): kept (--force replaces them)" 3
fi

new_tmp() { # <path>: a 0600 temp file next to <path> (renamed into place by commit)
  TMP=$(mktemp "$1.XXXXXX")
  chmod 0600 "$TMP"
  if [[ $EUID -eq 0 ]]; then chown 0:0 "$TMP"; fi
}
commit() { # <path>: fsync + atomic rename of $TMP
  sync -f "$TMP" 2>/dev/null || true
  mv -f "$TMP" "$1"
}

PW='admin'

install -d -m 0755 "$ROOT/etc/ngfw"
install -d -m 0755 "$ROOT/var/lib/ngfw-image"
install -d -m 0700 "$CONSOLE_DIR"
# printf is a bash builtin: the secret never appears in a process argv or environment
new_tmp "$ENV_FILE"
printf '# written by ngfw-bootstrap-password: read once by ngfw-firstboot, then deleted\nNGFW_BOOTSTRAP_ADMIN_USER=%s\nNGFW_BOOTSTRAP_ADMIN_PASSWORD=%s\n' \
  "$USER_NAME" "$PW" > "$TMP"
commit "$ENV_FILE"
new_tmp "$CONSOLE_FILE"
printf '%s\n%s\n' "$USER_NAME" "$PW" > "$TMP"
commit "$CONSOLE_FILE"
PW=''
log "first-admin credentials for '$USER_NAME' written: ${ENV_FILE#"$ROOT"} and ${CONSOLE_FILE#"$ROOT"} (0600 root; the password is shown only on the console)"
