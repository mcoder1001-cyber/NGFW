# Rendered by ngfw-agent (keepalived renderer). Do not edit: every commit overwrites this file.
global_defs {
    router_id ngfw
    enable_script_security
    script_user root
    vrrp_version 3
}

vrrp_instance vi1 {
    state BACKUP
    interface w0-a
    virtual_router_id 81
    priority 150
    advert_int 0.5
    virtual_ipaddress {
        10.0.240.1/24 dev w0-a
    }
    notify_master "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE vi1 MASTER"
    notify_backup "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE vi1 BACKUP"
    notify_fault "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE vi1 FAULT"
    notify_stop "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE vi1 STOP"
}
