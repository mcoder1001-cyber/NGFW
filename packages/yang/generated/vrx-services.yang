          leaf action {
            type enumeration {
              enum "transmit";
              enum "drop";
              enum "mark-and-transmit";
            }
            default "transmit";
          }
          leaf dscp {
            type uint32 {
              range "0..63";
            }
            description "DSCP written by mark-and-transmit";
          }
        }
        container exceedAction {
          leaf action {
            type enumeration {
              enum "transmit";
              enum "drop";
              enum "mark-and-transmit";
            }
            default "transmit";
          }
          leaf dscp {
            type uint32 {
              range "0..63";
            }
            description "DSCP written by mark-and-transmit";
          }
        }
        container violateAction {
          description "Three-colour policers only";
          leaf action {
            type enumeration {
              enum "transmit";
              enum "drop";
              enum "mark-and-transmit";
            }
            default "transmit";
          }
          leaf dscp {
            type uint32 {
              range "0..63";
            }
            description "DSCP written by mark-and-transmit";
          }
        }
