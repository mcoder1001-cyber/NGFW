# P14 deploy/image common: generates the bootstrap admin password on the FIRST BOOT of an image that had no installer
# run (F-images' disk images are cloned, so each clone must get its own password at boot, never one baked into the
# image). On an ISO install the installer already wrote it (late-commands), so the conditions skip this unit; after
# vrx-firstboot has consumed bootstrap.env, firstboot.done keeps it from ever running again.
[Unit]
Description=VRX bootstrap admin password (first boot of an image without an installer)
DefaultDependencies=no
After=local-fs.target
Before=vrx-firstboot.service vrx-console-banner.service
ConditionPathExists=!/etc/vrx/bootstrap.env
ConditionPathExists=!/var/lib/vrx/firstboot.done
ConditionPathExists=!/var/lib/vrx-image/console/bootstrap-password

[Service]
Type=oneshot
ExecStart=/usr/lib/vrx-image/vrx-bootstrap-password
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
