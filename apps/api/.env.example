# ngfw-api environment (all NGFW_*; validated at boot by src/config.ts). Never put real secrets in this file.
NGFW_HTTP_HOST=127.0.0.1
NGFW_HTTP_PORT=3000
NGFW_LOG_LEVEL=info
# PostgreSQL DSN (deploy/dev/pg-test.sh writes NGFW_PG_DSN into /run/ngfw-test/<prefix>/pg.env)
NGFW_DATABASE_URL=
NGFW_VALKEY_URL=redis://127.0.0.1:6379
NGFW_VALKEY_DB=0
NGFW_VALKEY_PREFIX=ngfw:
NGFW_AGENT_SOCKET=/run/ngfw/agent.sock
NGFW_AGENT_OWNER=
# ≥ 32 characters; unset = random per process (sessions end on restart)
NGFW_JWT_SECRET=
NGFW_ACCESS_TTL_SEC=900
NGFW_REFRESH_TTL_SEC=604800
# Secure refresh cookie (default 1); set 0 only for plain-http development
NGFW_COOKIE_SECURE=1
NGFW_SECRET_KEY_FILE=/var/lib/ngfw/secret.key
NGFW_BOOTSTRAP_ADMIN_USER=admin
# first admin, created only when app_user is empty (D-048)
NGFW_BOOTSTRAP_ADMIN_PASSWORD=
# DEVELOPMENT ONLY: 1 accepts new passwords shorter than 12 characters (never in a product image)
NGFW_DEV_WEAK_PASSWORDS=0
NGFW_LOCK_TTL_SEC=1800
NGFW_LOGIN_RATE_PER_MIN=20
NGFW_LOGIN_MAX_FAILURES=10
NGFW_LOGIN_LOCKOUT_SEC=900
NGFW_PASSWORD_RATE_PER_MIN=5
NGFW_WS_HEARTBEAT_MS=15000
