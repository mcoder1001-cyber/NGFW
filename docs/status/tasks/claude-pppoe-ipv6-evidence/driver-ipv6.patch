--- pppoe/dhcp6s.py	1970-01-01 00:00:00.000000000 +0000
+++ pppoe-ipv6/dhcp6s.py	2026-10-07 06:11:36.790649927 +0000
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Minimal stateful DHCPv6 server for the PPPoE IPv6 lab ISP (test only): IA_NA + IA_PD.
+usage: dhcp6s.py IFACE ADDR PREFIX/LEN   e.g. dhcp6s.py ppp0 2001:db8:9::100 2001:db8:9100::/56"""
+import ipaddress, socket, struct, sys
+iface, addr, pfx = sys.argv[1], ipaddress.IPv6Address(sys.argv[2]), ipaddress.IPv6Network(sys.argv[3])
+idx = socket.if_nametoindex(iface)
+s = socket.socket(socket.AF_INET6, socket.SOCK_DGRAM)
+s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+s.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, iface.encode())
+s.bind(("::", 547))
+s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_JOIN_GROUP, socket.inet_pton(socket.AF_INET6, "ff02::1:2") + struct.pack("@I", idx))
+SERVER_ID = struct.pack("!HH", 3, 1) + bytes.fromhex("020000000947")
+NAMES = {1: "SOLICIT", 3: "REQUEST", 5: "RENEW", 6: "REBIND", 8: "RELEASE", 11: "INFO-REQUEST"}
+
+def opt(code, data):
+    return struct.pack("!HH", code, len(data)) + data
+
+def parse(b):
+    out, i = [], 0
+    while i + 4 <= len(b):
+        c, l = struct.unpack("!HH", b[i:i + 4]); out.append((c, b[i + 4:i + 4 + l])); i += 4 + l
+    return out
+
+while True:
+    data, src = s.recvfrom(4096)
+    if len(data) < 4 or data[0] not in NAMES:
+        continue
+    mt, xid, opts = data[0], data[1:4], parse(data[4:])
+    print("rx", NAMES[mt], "from", src[0], "opts", [c for c, _ in opts], flush=True)
+    out = b""
+    for c, v in opts:
+        if c == 1:
+            out += opt(1, v)
+        elif c == 3 and len(v) >= 12 and mt != 8:
+            out += opt(3, v[:4] + struct.pack("!II", 1000, 2000) + opt(5, addr.packed + struct.pack("!II", 3000, 4000)))
+        elif c == 25 and len(v) >= 12 and mt != 8:
+            out += opt(25, v[:4] + struct.pack("!II", 1000, 2000) + opt(26, struct.pack("!IIB", 3000, 4000, pfx.prefixlen) + pfx.network_address.packed))
+    out += opt(2, SERVER_ID)
+    rapid = any(c == 14 for c, _ in opts)
+    if mt == 1 and rapid:
+        out += opt(14, b"")
+    rt = 2 if (mt == 1 and not rapid) else 7
+    s.sendto(bytes([rt]) + xid + out, (src[0], 546, 0, idx))
+    print("tx", "ADVERTISE" if rt == 2 else "REPLY", flush=True)
