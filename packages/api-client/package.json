{
  "name": "@ngfw/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "gen": "pnpm --filter @ngfw/api openapi && openapi-typescript openapi.json -o src/generated/schema.d.ts && prettier --write src/generated/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "echo 'api-client: generated \u2014 no tests'"
  },
  "dependencies": {
    "openapi-fetch": "^0.14"
  },
  "devDependencies": {
    "openapi-typescript": "^7",
    "typescript": "^5.6",
    "prettier": "^3"
  }
}
