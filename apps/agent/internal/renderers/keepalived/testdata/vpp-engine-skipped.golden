# Rendered by ngfw-agent (keepalived renderer). Do not edit: every commit overwrites this file.
global_defs {
    router_id ngfw
    enable_script_security
    script_user root
    vrrp_version 3
}

vrrp_instance one {
    state BACKUP
    interface w0-a
    virtual_router_id 83
    priority 100
    advert_int 1
    virtual_ipaddress {
        10.0.240.1/32 dev w0-a
    }
    notify_master "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE one MASTER"
    notify_backup "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE one BACKUP"
    notify_fault "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE one FAULT"
    notify_stop "/opt/ngfw-test/bin/ngfw-keepalived-notify /run/ngfw-test/w0/keepalived/state INSTANCE one STOP"
}
