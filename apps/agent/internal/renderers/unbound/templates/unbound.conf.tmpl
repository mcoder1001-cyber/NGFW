# Generated by vrx-agent (RF-3 unbound renderer). Do not edit: the next commit overwrites it.
{{- if .Input}}
# vrx-input: {{b64 .Input}}
{{- end}}
{{- range .Resolvers}}
# resolver {{quoted .Name}}{{if .Description}}: {{quoted .Description}}{{end}}
{{- else}}
# no enabled resolver: idle instance on loopback
{{- end}}
server:
	directory: {{quoted .Paths.ConfDir}}
	chroot: ""
	username: {{quoted .Paths.Username}}
	pidfile: {{quoted .Paths.PidFile}}
	do-daemonize: no
{{- if .Paths.LogFile}}
	use-syslog: no
	logfile: {{quoted .Paths.LogFile}}
{{- else}}
	use-syslog: yes
{{- end}}
	verbosity: 1
	port: {{.Port}}
{{- range .Interfaces}}
	interface: {{sockaddr .}}
{{- else}}
	interface: 127.0.0.1@{{.Port}}
{{- end}}
	num-threads: {{.Threads}}
	msg-cache-size: {{.Cache.MsgMB}}m
	rrset-cache-size: {{.Cache.RRsetMB}}m
	cache-min-ttl: {{.Cache.MinTTL}}
	cache-max-ttl: {{.Cache.MaxTTL}}
	prefetch: {{yesno .Cache.Prefetch}}
	qname-minimisation: {{yesno .QnameMin}}
	hide-identity: {{yesno .HideIdentity}}
	hide-version: {{yesno .HideVersion}}
	log-queries: {{yesno .LogQueries}}
	harden-glue: yes
	harden-below-nxdomain: yes
	harden-dnssec-stripped: {{yesno .DNSSEC}}
{{- range .Access}}
	access-control: {{network .Prefix}} {{.Action}}
{{- end}}
{{- if .DNSSEC}}
{{- if .AutoAnchor}}
	auto-trust-anchor-file: {{quoted .Paths.TrustAnchor}}
{{- else}}
	trust-anchor-file: {{quoted .Paths.RootKey}}
{{- end}}
{{- else}}
	module-config: "iterator"
{{- end}}
{{- if .NeedTLS}}
	tls-cert-bundle: {{quoted .Paths.TLSCertBundle}}
{{- end}}
{{- range .Zones}}
{{template "zone" .}}
{{- end}}
{{- range .Views}}
{{- $v := .Name}}
{{- range .Interfaces}}
	interface-view: {{sockaddr .}} {{ident $v}}
{{- end}}
{{- end}}

remote-control:
	control-enable: yes
	control-interface: {{quoted .Paths.ControlSocket}}
	control-use-cert: no
{{- range .Views}}

view:
	name: {{quoted .Name}}
	view-first: yes
{{- range .Zones}}
{{template "zone" .}}
{{- end}}
{{- end}}
{{- range .Forwards}}

forward-zone:
	name: {{quoted .Zone}}
{{- range .Addrs}}
	forward-addr: {{fwdaddr .}}
{{- end}}
	forward-first: {{yesno .First}}
	forward-tls-upstream: {{yesno .TLS}}
{{- end}}
{{define "zone"}}	local-zone: {{quoted .Zone}} {{.Type}}
{{- range .Data}}
	local-data: {{rr .}}
{{- end}}{{end}}
