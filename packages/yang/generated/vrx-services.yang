        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        leaf description {
          type string {
            // pattern dropped: not XSD-expressible
            length "0..255";
          }
        }
        leaf rateKbps {
          type uint32 {
            range "1..4294967295";
          }
          mandatory true;
