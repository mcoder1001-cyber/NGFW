diff -ruN pppoe/ra.py pppoe-ipv6/ra.py
--- pppoe/ra.py	1970-01-01 00:00:00.000000000 +0000
+++ pppoe-ipv6/ra.py	2026-10-07 06:11:36.790462964 +0000
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Minimal periodic Router Advertisement sender (test ISP): ra.py IFACE PREFIX/64 [managed]."""
+import socket, struct, sys, time, ipaddress
+iface, pfx = sys.argv[1], ipaddress.IPv6Network(sys.argv[2])
+managed = len(sys.argv) > 3 and sys.argv[3] == "managed"
+s = socket.socket(socket.AF_INET6, socket.SOCK_RAW, socket.IPPROTO_ICMPV6)
+s.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, iface.encode())
+s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_MULTICAST_HOPS, 255)
+s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_UNICAST_HOPS, 255)
+idx = socket.if_nametoindex(iface)
+flags = (0x80 | 0x40) if managed else 0
+ra = struct.pack("!BBHBBHII", 134, 0, 0, 64, flags, 1800, 0, 0)
+pio = struct.pack("!BBBBIII", 3, 4, pfx.prefixlen, 0xC0, 86400, 14400, 0) + pfx.network_address.packed
+mtu = struct.pack("!BBHI", 5, 1, 0, 1492)
+pkt = ra + pio + mtu
+import os, select
+period = float(os.environ.get("RA_PERIOD", "2"))
+nxt = 0.0
+while True:
+    now = time.time()
+    if now >= nxt:
+        try:
+            s.sendto(pkt, ("ff02::1", 0, 0, idx)); print("ra periodic", flush=True)
+        except OSError as e:
+            print("ra send:", e, flush=True)
+        nxt = now + period
+    r, _, _ = select.select([s], [], [], max(0.05, nxt - time.time()))
+    if r:
+        data, src = s.recvfrom(1500)
+        if data and data[0] == 133:
+            print("rs from", src[0], flush=True)
+            try:
+                s.sendto(pkt, ("ff02::1", 0, 0, idx)); print("ra solicited", flush=True)
+            except OSError as e:
+                print("ra send:", e, flush=True)
