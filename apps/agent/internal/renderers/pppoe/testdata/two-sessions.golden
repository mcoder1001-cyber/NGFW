### /etc/ppp/ip-down.d/ngfw-wan0 mode=-rwxr-xr-x
#!/bin/sh
# ngfw-agent PPPoE ip-down hook (F-pppoe-client). pppd runs this and sets PPP_IFACE, PPP_IPPARAM,
# IPLOCAL, IPREMOTE, DNS1, DNS2. It only acts for our own session (PPP_IPPARAM = the config interface)
# and writes a state file the agent reads. Rendered; hand edits are overwritten.
set -eu
[ "${PPP_IPPARAM:-}" = "ngfw-wan0" ] || exit 0
dir="/srv/run/ngfw/pppoe"
f="$dir/wan0.state"
mkdir -p "$dir"
tmp="$f.tmp.$$"
{
  echo "phase=down"
  echo "hostif=wan0"
  echo "ppp_iface=${PPP_IFACE:-}"
  echo "local=${IPLOCAL:-}"
  echo "peer=${IPREMOTE:-}"
  echo "dns1=${DNS1:-}"
  echo "dns2=${DNS2:-}"
  echo "at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$tmp"
mv -f "$tmp" "$f"

