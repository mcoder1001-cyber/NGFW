### /etc/ppp/pap-secrets mode=-rw------- secret
# vrx-agent PPPoE client secrets (F-pppoe-client). Rendered; do not edit.
"alice@isp" vrx-wan0 "s3cr#t \"x" *
"bob" vrx-wan1 "pw" *

### /etc/ppp/peers/vrx-wan0 mode=-rw-r--r--
# vrx-agent PPPoE client (F-pppoe-client) — session wan0. Rendered; hand edits are overwritten.
plugin rp-pppoe.so
nic-wan0
rp_pppoe_service "vrx-fiber"
user "alice@isp"
remotename vrx-wan0
mtu 1492
mru 1492
noipdefault
defaultroute
replacedefaultroute
usepeerdns
+ipv6
hide-password
noauth
lcp-echo-interval 20
lcp-echo-failure 3
persist
holdoff 5
maxfail 0

### /etc/ppp/peers/vrx-wan1 mode=-rw-r--r--
# vrx-agent PPPoE client (F-pppoe-client) — session wan1. Rendered; hand edits are overwritten.
plugin rp-pppoe.so
nic-wan1
user "bob"
remotename vrx-wan1
mtu 1480
mru 1480
noipdefault
nodefaultroute
noipv6
hide-password
noauth
lcp-echo-interval 20
lcp-echo-failure 3
persist
holdoff 10
maxfail 3

### /etc/systemd/system/vrx-pppoe-wan0.service mode=-rw-r--r--
# vrx-agent PPPoE client (F-pppoe-client) — session wan0. Rendered; hand edits are overwritten.
[Unit]
Description=vrx PPPoE client on wan0
After=network.target vpp.service
[Service]
Type=simple
ExecStart=/usr/sbin/pppd call vrx-wan0 nodetach ipparam vrx-wan0
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target

### /etc/systemd/system/vrx-pppoe-wan1.service mode=-rw-r--r--
# vrx-agent PPPoE client (F-pppoe-client) — session wan1. Rendered; hand edits are overwritten.
[Unit]
Description=vrx PPPoE client on wan1
After=network.target vpp.service
[Service]
Type=simple
ExecStart=/usr/sbin/pppd call vrx-wan1 nodetach ipparam vrx-wan1
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target

