{{- /* swanctl.conf(5) secrets: PSKs only ever as base64 (0s…); ids quoted. */ -}}
# vrx-secrets.conf: rendered by vrx-agent (strongswan renderer); mode 0600.
# Pre-shared keys are base64-encoded (0s prefix); never copy this file anywhere.
secrets {
{{- range .Secrets}}
	{{name .Name}} {
		id-local = {{q .LocalID}}
		id-remote = {{q .RemoteID}}
		secret = 0s{{b64 .Value}}
	}
{{- end}}
}
