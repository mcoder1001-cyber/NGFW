        "numaOnly": false,
        "id": 0
      },
      "subinterfaces": {
        "100": { "vlanId": 100, "enabled": true, "ipv4": ["198.51.100.1/24"], "vrf": "default" }
      }
    },
    "BondEthernet1": {
      "enabled": true,
      "ipv4": ["203.0.113.1/24"],
      "bond": {
        "mode": "active-backup",
        "members": {
          "TenGigabitEthernet0/0/2": { "passive": false, "longTimeout": false, "weight": 200 },
          "TenGigabitEthernet0/0/3": { "passive": false, "longTimeout": false, "weight": 100 }
