{
 "components": {
  "schemas": {
   "InterfacesConfig": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "maxLength": 255,
       "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f-\\u009f]*$",
       "title": "Description",
       "type": "string",
       "x-vrx-ui": {
        "group": "general",
        "order": 2
       }
      },
      "dhcpClient": {
       "additionalProperties": false,
       "properties": {
        "clientId": {
         "maxLength": 64,
         "minLength": 1,
         "pattern": "^[\\x21-\\x7e]+$",
         "title": "Client identifier",
         "type": "string",
         "x-vrx-ui": {
          "help": "option 61; absent = the interface MAC address",
          "order": 2
         }
        },
        "hostname": {
         "maxLength": 253,
         "minLength": 1,
         "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
         "title": "Hostname",
         "type": "string",
         "x-vrx-ui": {
          "help": "sent in option 12; absent = the system hostname",
          "order": 1
         }
        },
        "setBroadcastFlag": {
         "default": false,
         "title": "Broadcast flag",
         "type": "boolean",
         "x-vrx-ui": {
          "help": "ask the server to broadcast its replies",
          "order": 3
         }
        }
       },
       "title": "DHCP client",
       "type": "object",
       "x-vrx-ui": {
        "group": "addressing",
        "help": "obtain an IPv4 address by DHCP; cannot be combined with unnumbered",
        "order": 14
       }
      },
      "enabled": {
       "default": false,
       "title": "Enabled",
       "type": "boolean",
       "x-vrx-ui": {
        "group": "general",
        "help": "admin state; interfaces stay down until enabled",
        "order": 1
       }
      },
      "ipv4": {
       "default": [],
       "items": {
        "format": "cidrv4",
        "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\/([0-9]|[1-2][0-9]|3[0-2])$",
        "title": "IPv4 CIDR",
        "type": "string",
        "x-vrx-ui": {
         "help": "e.g. 10.0.0.1/24",
         "widget": "cidr"
        }
       },
       "maxItems": 32,
       "title": "IPv4 addresses",
       "type": "array",
       "x-vrx-ui": {
        "group": "addressing",
        "help": "addresses with prefix length, e.g. 10.0.0.1/24",
        "order": 10
       }
      },
      "ipv6": {
       "default": [],
       "items": {
        "format": "cidrv6",
        "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))\\/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$",
        "title": "IPv6 CIDR",
        "type": "string",
        "x-vrx-ui": {
         "help": "e.g. 2001:db8::1/64",
         "widget": "cidr"
        }
       },
       "maxItems": 32,
       "title": "IPv6 addresses",
       "type": "array",
       "x-vrx-ui": {
        "group": "addressing",
        "help": "addresses with prefix length, e.g. 2001:db8::1/64",
        "order": 11
       }
      },
      "mac": {
       "pattern": "^[0-9a-fA-F]{2}([:-])(?:[0-9a-fA-F]{2}\\1){4}[0-9a-fA-F]{2}$",
       "title": "MAC address",
       "type": "string",
       "x-vrx-ui": {
        "group": "general",
        "help": "override the hardware address; absent = keep the burned-in MAC",
        "order": 4,
        "widget": "mac"
       }
      },
      "mtu": {
       "maximum": 9216,
       "minimum": 68,
       "title": "MTU",
       "type": "integer",
       "x-vrx-ui": {
        "group": "general",
        "help": "L3 MTU in bytes (68\u20139216); absent = keep the driver default",
        "order": 3,
        "widget": "number"
       }
      },
      "promiscuous": {
       "default": false,
       "title": "Promiscuous",
       "type": "boolean",
       "x-vrx-ui": {
        "group": "general",
        "help": "accept frames for any destination MAC",
        "order": 5
       }
      },
      "rxMode": {
       "enum": [
        "polling",
        "interrupt",
        "adaptive"
       ],
       "title": "RX mode",
       "type": "string",
       "x-vrx-ui": {
        "group": "general",
        "help": "polling (default for DPDK), interrupt or adaptive",
        "order": 6,
        "widget": "select"
       }
      },
      "subinterfaces": {
       "additionalProperties": {
        "additionalProperties": false,
        "properties": {
         "description": {
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f-\\u009f]*$",
          "title": "Description",
          "type": "string",
          "x-vrx-ui": {
           "group": "general",
           "order": 2
          }
         },
         "dhcpClient": {
          "additionalProperties": false,
