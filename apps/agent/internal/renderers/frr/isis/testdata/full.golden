frr version 10.7.1
frr defaults traditional
log syslog informational
service integrated-vtysh-config
!
interface w8-l0
 ip router isis ngfw
 ipv6 router isis ngfw
 isis circuit-type level-2-only
 isis network point-to-point
 isis metric 10
 isis bfd
exit
!
interface w8-l1
 ip router isis ngfw
 ipv6 router isis ngfw
 isis circuit-type level-1
exit
!
interface w8-lo
 ip router isis ngfw
 ipv6 router isis ngfw
 isis passive
exit
!
router isis ngfw
 is-type level-1-2
 net 49.0001.1921.6800.1001.00
 metric-style wide
 redistribute ipv4 connected level-1 metric 20
 redistribute ipv6 connected level-1 metric 20
 redistribute ipv4 connected level-2 metric 20
 redistribute ipv6 connected level-2 metric 20
 redistribute ipv4 ospf level-1
 redistribute ipv4 ospf level-2
 redistribute ipv4 bgp level-1 route-map rm-in
 redistribute ipv6 bgp level-1 route-map rm-in
 redistribute ipv4 bgp level-2 route-map rm-in
 redistribute ipv6 bgp level-2 route-map rm-in
exit
!
end
