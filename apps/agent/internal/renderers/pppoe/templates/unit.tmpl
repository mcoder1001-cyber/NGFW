# vrx-agent PPPoE client (F-pppoe-client) — session {{ident .HostIf}}. Rendered; hand edits are overwritten.
[Unit]
Description=vrx PPPoE client on {{ident .HostIf}}
After=network.target vpp.service
[Service]
Type=simple
ExecStart={{.PppdBin}} call vrx-{{ident .HostIf}} nodetach ipparam {{ident .Remotename}}
Restart=on-failure
RestartSec={{.HoldoffSec}}
[Install]
WantedBy=multi-user.target
