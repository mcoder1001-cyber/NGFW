#!/usr/bin/env bash
# ngfw-console-banner — the first-boot console banner of a NGFW appliance (P14 deploy/image common piece; F-images reuses
# it read-only). Installed as /usr/lib/ngfw-image/ngfw-console-banner, run by ngfw-console-banner.service (render, every
# boot, before the login prompts) and ngfw-console-banner-login.timer (check-login, every 30 s until the first login).
#
#   ngfw-console-banner render      [--root DIR] [--no-console]
#   ngfw-console-banner check-login [--root DIR]
#
# render       writes etc/issue.d/50-ngfw-console.issue — agetty prints /etc/issue plus /etc/issue.d/*.issue above every
#              console login prompt (tty and serial). It carries the management address and the HTTPS URL as agetty
#              escapes (\4, \6: agetty fills in the current address and follows DHCP changes) and, while
#              var/lib/ngfw-image/console/bootstrap-password exists, the first-admin user and password (the issue file is
#              then 0600 root — agetty runs as root; 0644 otherwise). It also writes the same text, with the address
#              resolved now, once to every active console (/sys/class/tty/console/active) — never to stdout/the journal.
# check-login  once first boot is done (var/lib/ngfw/firstboot.done) and the database holds no bootstrap admin that is
#              still unused (app_user: source 'bootstrap', last_login NULL, credential_gen 0 — i.e. it logged in, its
#              password was changed, or it is gone), deletes the password file, renders the banner without it and
#              disables the timer. An unreachable database changes nothing (retried by the timer).
# The issue file name differs from the agent's own banner drop-ins (/etc/issue.d/ngfw.issue, ngfw-ssh.banner — D-183),
# so the two never overwrite each other; sshd never shows this file (its Banner is ngfw-ssh.banner).
set -euo pipefail
export LC_ALL=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

CMD=${1:-}; [[ $# -gt 0 ]] && shift
ROOT=/ CONSOLE=1
die() { printf 'ngfw-console-banner: ERROR: %s\n' "$*" >&2; exit 1; }
log() { printf 'ngfw-console-banner: %s\n' "$*"; }
while (($#)); do
  case $1 in
    --root) ROOT=${2:?--root needs a directory}; shift ;;
    --no-console) CONSOLE=0 ;;
    *) die "unknown argument '$1'" ;;
  esac
  shift
done
case $CMD in
  render|check-login) ;;
  -h|--help) sed -n '2,/^set -euo pipefail/{/^set -euo pipefail/!p}' "$0" | sed -E 's/^# ?//'; exit 0 ;;
  '') die "give a command: render | check-login (try --help)" ;;
  *) die "unknown command '$CMD' (render | check-login)" ;;
esac
[[ -d $ROOT ]] || die "--root $ROOT is not a directory"
ROOT=${ROOT%/}
LIVE=0; [[ -z $ROOT ]] && LIVE=1          # acting on the running system (not an image tree / a test root)
((LIVE)) || CONSOLE=0

ISSUE=$ROOT/etc/issue.d/50-ngfw-console.issue
PWFILE=$ROOT/var/lib/ngfw-image/console/bootstrap-password
DONE=$ROOT/var/lib/ngfw/firstboot.done
TIMER=ngfw-console-banner-login.timer

# the password file: line 1 user, line 2 password; anything outside the generator's alphabets is refused (it would be
# interpreted by agetty or garble the console)
read_credentials() {
  ADMIN_USER='' ADMIN_PW=''
  [[ -f $PWFILE ]] || return 1
  { IFS= read -r ADMIN_USER || true; IFS= read -r ADMIN_PW || true; } < "$PWFILE"
  if [[ ! $ADMIN_USER =~ ^[a-z][a-z0-9_-]{0,31}$ || ! $ADMIN_PW =~ ^[A-Za-z0-9]{12,64}$ ]]; then
    log "WARNING: $PWFILE is malformed: the password is not shown"
    ADMIN_USER='' ADMIN_PW=''
    return 1
  fi
}

current_ipv4() { # first global IPv4 address, for the one-time console message (agetty's \4 does this at the prompt)
  ip -4 -o addr show scope global 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4; exit }'
}

issue_text() { # stdout: the issue file (agetty escapes, so no literal backslash may come from data)
  printf 'NGFW appliance \\n (\\l)\n'
  printf '  Management address : \\4  \\6\n'
  printf '  Web UI             : https://\\4/\n'
  if [[ -n $ADMIN_PW ]]; then
    printf '  First admin        : user %s  password %s\n' "$ADMIN_USER" "$ADMIN_PW"
    printf '                       (shown until this account first logs in; change the password in the web UI)\n'
  fi
  printf '\n'
}

console_text() { # stdout: the one-time console message (addresses resolved now)
  local ip4; ip4=$(current_ipv4 || true)
  printf '\n==================== NGFW appliance ====================\n'
  if [[ -n $ip4 ]]; then
    printf '  Management address : %s\n  Web UI             : https://%s/\n' "$ip4" "$ip4"
  else
    printf '  Management address : none yet (no DHCP lease) — the login prompt shows it once the network is up\n'
  fi
  if [[ -n $ADMIN_PW ]]; then
    printf '  First admin        : user %s  password %s\n' "$ADMIN_USER" "$ADMIN_PW"
    printf '  The password is shown until this account first logs in.\n'
  fi
  printf '========================================================\n\n'
}

render() {
  local with_pw=0 tmp mode=0644 c
  if read_credentials; then with_pw=1; mode=0600; fi
  install -d -m 0755 "$ROOT/etc/issue.d"
  tmp=$(mktemp "$ISSUE.XXXXXX")
  chmod "$mode" "$tmp"                      # 0600 before the password is written into it
  issue_text > "$tmp"
  mv -f "$tmp" "$ISSUE"
  if ((CONSOLE)); then
    local consoles=()
    read -r -a consoles < /sys/class/tty/console/active 2>/dev/null || true   # one line: "tty0 ttyS0"
    for c in "${consoles[@]}"; do
      [[ $c =~ ^tty[A-Za-z0-9]*$ && -c /dev/$c ]] || continue
      console_text > "/dev/$c" 2>/dev/null || true
    done
  fi
  if ((LIVE)) && command -v agetty >/dev/null; then agetty --reload >/dev/null 2>&1 || true; fi
  ADMIN_PW=''
  log "banner rendered: ${ISSUE#"$ROOT"} (bootstrap password $( ((with_pw)) && echo "shown until the first login" || echo "not shown"))"
}

unused_bootstrap_admins() { # stdout: the number of bootstrap admins that never logged in and kept their password
  local q="select count(*) from app_user where source = 'bootstrap' and last_login is null and credential_gen = 0"
  if ((!LIVE)) && [[ -n ${NGFW_CONSOLE_BANNER_TEST_QUERY:-} ]]; then
    "$NGFW_CONSOLE_BANNER_TEST_QUERY" "$q"     # tests only: never honoured on the running system
  else
    runuser -u postgres -- psql -XAtq -d ngfw -c "$q"
  fi
}

check_login() {
  if [[ ! -f $PWFILE ]]; then
    if ((LIVE)); then systemctl disable --now "$TIMER" >/dev/null 2>&1 || true; fi
    log "no bootstrap password on this box"
    return 0
  fi
  [[ -f $DONE ]] || { log "first boot not finished: bootstrap password kept"; return 0; }
  local n
  if ! n=$(unused_bootstrap_admins 2>/dev/null) || [[ ! $n =~ ^[0-9]+$ ]]; then
    log "database not reachable: bootstrap password kept (retried)"
    return 0
  fi
  # Compare decimal text: Bash arithmetic can overflow or interpret leading zeros
  # as octal. Only a confirmed zero count permits credential removal.
  if [[ ! $n =~ ^0+$ ]]; then return 0; fi
  rm -f -- "$PWFILE"
  log "first admin login seen: bootstrap password deleted"
  CONSOLE=0
  render
  if ((LIVE)); then systemctl disable --now "$TIMER" >/dev/null 2>&1 || true; fi
}

case $CMD in
  render) render ;;
  check-login) check_login ;;
esac
