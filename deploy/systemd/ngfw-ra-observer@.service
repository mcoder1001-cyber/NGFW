[Unit]
Description=NGFW manager-opened private-unit observation for PID %i
StartLimitIntervalSec=10
StartLimitBurst=64

[Service]
Type=exec
User=root
Group=ngfw
ExecStart=/usr/lib/ngfw/ngfw-ra-namespace-broker --observe-unit %i
OpenFile=/run/ngfw/ra/source-agent-exe:source-agent-exe:read-only
UMask=0077
RuntimeMaxSec=10
TimeoutStopSec=2
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=~@mount @reboot @swap @raw-io @debug
StandardOutput=null
StandardError=null
LimitCORE=0
LimitNOFILE=32
TasksMax=16
MemoryMax=128M
