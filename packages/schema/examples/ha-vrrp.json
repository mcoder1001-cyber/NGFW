{
  "vrfs": {
    "default": { "id": 0, "description": "global routing table" },
    "customer-a": { "id": 10, "description": "customer A" }
  },
  "interfaces": {
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "description": "uplink",
      "mtu": 1500,
      "ipv4": ["198.51.100.2/30"],
      "ipv6": ["2001:db8:0:1::2/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "description": "lan",
      "mtu": 1500,
      "ipv4": ["192.168.10.1/24"],
      "ipv6": ["2001:db8:10::1/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/2": {
      "enabled": true,
      "description": "customer A access",
      "mtu": 1500,
      "ipv4": ["10.20.0.1/24"],
      "vrf": "customer-a",
      "rxMode": "polling"
    }
  },
  "ha": {
    "vrrp": {
      "lan-v4": {
        "interface": "TenGigabitEthernet0/0/1",
        "vrId": 10,
        "priority": 200,
        "addresses": ["192.168.10.254"],
        "vrf": "default",
        "track": [{ "interface": "TenGigabitEthernet0/0/0", "priorityDecrement": 50 }]
      },
      "lan-v6": {
        "interface": "TenGigabitEthernet0/0/1",
        "vrId": 10,
        "addressFamily": "ipv6",
        "addresses": ["2001:db8:10::fe"],
        "vrf": "default",
        "acceptMode": true
      },
      "customer-a": {
        "interface": "TenGigabitEthernet0/0/2",
        "vrId": 1,
        "vrf": "customer-a",
        "addresses": ["10.20.0.254"],
        "unicast": { "peers": ["10.20.0.3"] },
        "engine": "keepalived",
        "advertisementIntervalMs": 500
      }
    },
    "cluster": {
      "enabled": true,
      "nodeName": "vrx-a",
      "peers": [{ "name": "vrx-b", "address": "192.168.10.3" }],
      "secretRef": "key/cluster-sync",
      "interface": "TenGigabitEthernet0/0/1",
      "vrf": "default",
      "stateSync": { "nat": true, "ipsec": true }
    }
  }
}
