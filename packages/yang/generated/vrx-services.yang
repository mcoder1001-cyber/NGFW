          description "Reference to a stored secret of kind cert. The secret itself is never part of the configuration.";
        }
        leaf keyRef {
          type string {
            pattern "(key)/[A-Za-z0-9][A-Za-z0-9_.-]{0,62}";
            length "1..127";
          }
          mandatory true;
          description "Reference to a stored secret of kind key. The secret itself is never part of the configuration.";
        }
        leaf port {
          type uint32 {
            range "1..65535";
          }
          default "4460";
        }
      }
      container makestep {
        leaf thresholdSec {
          type decimal64 {
            fraction-digits 6;
          }
          default "1";
        }
        leaf limit {
          type int32 {
            range "-1..100";
          }
          default "3";
          description "Number of clock updates that may step; -1 = always";
        }
      }
    }
    container qos {
