          leaf weight {
            type uint32 {
              range "1..255";
            }
            default "1";
            description "relative share when a route has several paths";
          }
          leaf vrf {
            type string {
              pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
              length "1..63";
            }
            description "end-of-stack routes only: pop the label and look the IP payload up in this VRF (no next hop, no interface)";
