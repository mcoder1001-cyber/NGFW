# Rendered by ngfw-agent (snmpd renderer). Do not edit: every commit overwrites this file.
# Holds SNMP communities and USM passphrases: mode 0600.
agentaddress udp:127.0.0.1:3861
dontLogTCPWrappersConnects yes
sysName ngfw-w8
sysLocation Rack 4, Hall B
sysContact noc@example.net

# views
view ngfw_all included .1
view sys included .1.3.6.1.2.1.1

# SNMPv3 USM users
createUser md5d MD5 "NGFW_TEST_PSK_RF4_u2auth" DES "NGFW_TEST_PSK_RF4_priv"
rouser md5d priv -V ngfw_all
createUser mon
rouser mon noauth -V sys
createUser u1 SHA-256 "NGFW_TEST_PSK_RF4_auth" AES "NGFW_TEST_PSK_RF4_priv"
rouser u1 priv -V ngfw_all
createUser u2 SHA-512 "NGFW_TEST_PSK_RF4_u2auth"
rwuser u2 auth -V ngfw_all

# AgentX master for the private-MIB subagent (F-snmp)
master agentx
agentXSocket unix:/run/ngfw-test/w0/snmpd/agentx.sock
agentXPerms 0600 0700
