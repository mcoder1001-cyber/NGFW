{
  "interfaces": {
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "description": "WAN",
      "ipv4": ["203.0.113.2/24"],
      "vrf": "default"
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "description": "LAN",
      "ipv4": ["192.168.1.1/24"],
      "vrf": "default"
    }
  },
  "vrfs": { "default": { "id": 0, "description": "global routing table" } },
  "nat": {
    "enabled": true,
    "mode": "ed",
    "inside": ["TenGigabitEthernet0/0/1"],
    "outside": ["TenGigabitEthernet0/0/0"],
    "sessionLimit": 1048576,
    "pools": [
      {
        "name": "wan-pool",
        "description": "public addresses for outbound PAT",
        "range": "203.0.113.10-203.0.113.20",
        "vrf": "default"
      }
    ],
    "staticMappings": [
      {
        "name": "mail-1to1",
        "description": "1:1 for the mail server",
        "local": { "ip": "192.168.1.25" },
        "external": { "ip": "203.0.113.25" }
      },
      {
        "name": "web-forward",
        "protocol": "tcp",
        "local": { "ip": "192.168.1.80", "port": 80 },
        "external": { "ip": "203.0.113.3", "port": 8080 }
      },
      {
        "name": "ssh-via-pool",
        "protocol": "tcp",
        "local": { "ip": "192.168.1.22", "port": 22 },
        "external": { "pool": "wan-pool", "port": 2222 }
      },
      {
        "name": "dns-via-wan-if",
        "protocol": "udp",
        "local": { "ip": "192.168.1.53", "port": 53 },
        "external": { "interface": "TenGigabitEthernet0/0/0", "port": 53 }
      }
    ],
    "identityMappings": [
      {
        "description": "never translate the WAN address itself",
        "interface": "TenGigabitEthernet0/0/0"
      }
    ],
    "timeouts": { "udp": 300, "tcpEstablished": 7440, "tcpTransitory": 240, "icmp": 60 }
  }
}
