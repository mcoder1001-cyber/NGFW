            description "Translation used when the packet's QoS bits were recorded from ip (0–63); unlisted values map to 0";
            leaf from {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
            leaf to {
              type uint32 {
                range "0..255";
              }
              mandatory true;
            }
          }
        }
      }
      list interfaces {
        key "name";
        leaf name {
          type string;
          description "The map key.";
        }
        description "Keyed by engine interface name";
        leaf description {
          type string {
            // pattern dropped: not XSD-expressible
            length "0..255";
          }
        }
        container policer {
          leaf input {
            type string {
              pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
              length "1..63";
            }
            description "Name in qos.policers";
          }
          leaf output {
            type string {
              pattern "[A-Za-z0-9][A-Za-z0-9_.-]*";
              length "1..63";
            }
            description "Name in qos.policers";
          }
