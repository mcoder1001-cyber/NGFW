#!/bin/sh
# Rendered PPPoE IPv6 {{.Kind}} hook. The helper verifies process ownership,
# serializes state publication and returns setup/shutdown failures.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "${6:-}" = {{quoted .Remotename}} ] || exit 0
iface="${1:-}"
case "$iface" in ''|*[!A-Za-z0-9_.-]*) exit 0 ;; esac
# Capture admission before waiting for the helper action lock. Reopening a
# transition rotates this token, so a queued old hook cannot become admitted.
admission=""
IFS= read -r admission < {{quoted .StateDir}}/{{.HostIf}}.ipv6.admission || exit 0
exec /usr/bin/python3 {{quoted .IPv6Helper}} {{.Phase}} "$iface" "${LLLOCAL:-}" "${LLREMOTE:-}" "${PPPD_PID:-}" "$admission"
