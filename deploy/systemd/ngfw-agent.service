[Unit]
Description=NGFW dataplane agent
Requires=vpp.service ngfw-firstboot.service nftables.service
After=vpp.service ngfw-firstboot.service nftables.service
ConditionPathExists=/var/lib/ngfw/firstboot-complete

[Service]
Type=simple
User=root
Group=ngfw
ExecStart=/usr/sbin/ngfw-agent
Environment=NGFW_BASE_POLICY=1 NGFW_GLOBALS_OWNER=1 NGFW_SOCKET_GROUP=ngfw NGFW_AGENT_STATE_DIR=/var/lib/ngfw/agent
# Dedicated appliance scope only; never start this unit on the shared lab host.
Environment=NGFW_VPP_ID_RANGE=all
EnvironmentFile=-/etc/ngfw/agent.env
Restart=always
RestartSec=3
RuntimeDirectory=ngfw
RuntimeDirectoryMode=0750
StateDirectory=ngfw/agent
StateDirectoryMode=0750
UMask=0027
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictNamespaces=~cgroup
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_IPC_LOCK
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/ngfw/agent /var/lib/ngfw/captures /etc/ngfw/rsyslog-tls /run/ngfw
ReadWritePaths=-/etc/frr -/etc/swanctl -/etc/kea -/etc/unbound -/etc/chrony -/etc/rsyslog.d -/etc/snmp -/etc/keepalived

[Install]
WantedBy=multi-user.target
