# vrx-api environment (all VRX_*; validated at boot by src/config.ts). Never put real secrets in this file.
VRX_HTTP_HOST=127.0.0.1
VRX_HTTP_PORT=3000
VRX_LOG_LEVEL=info
# PostgreSQL DSN (deploy/dev/pg-test.sh writes VRX_PG_DSN into /run/vrx-test/<prefix>/pg.env)
VRX_DATABASE_URL=
VRX_VALKEY_URL=redis://127.0.0.1:6379
VRX_VALKEY_DB=0
VRX_VALKEY_PREFIX=vrx:
VRX_AGENT_SOCKET=/run/vrx/agent.sock
VRX_AGENT_OWNER=
# ≥ 32 characters; unset = random per process (sessions end on restart)
VRX_JWT_SECRET=
VRX_ACCESS_TTL_SEC=900
VRX_REFRESH_TTL_SEC=604800
# Secure refresh cookie (default 1); set 0 only for plain-http development
VRX_COOKIE_SECURE=1
VRX_SECRET_KEY_FILE=/var/lib/vrx/secret.key
VRX_BOOTSTRAP_ADMIN_USER=admin
# first admin, created only when app_user is empty (D-048)
VRX_BOOTSTRAP_ADMIN_PASSWORD=
# DEVELOPMENT ONLY: 1 accepts new passwords shorter than 12 characters (never in a product image)
VRX_DEV_WEAK_PASSWORDS=0
VRX_LOCK_TTL_SEC=1800
VRX_LOGIN_RATE_PER_MIN=20
VRX_LOGIN_MAX_FAILURES=10
VRX_LOGIN_LOCKOUT_SEC=900
VRX_PASSWORD_RATE_PER_MIN=5
VRX_WS_HEARTBEAT_MS=15000
