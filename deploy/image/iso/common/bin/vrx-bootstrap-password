#!/usr/bin/env bash
# vrx-bootstrap-password — write the first-admin credentials of a fresh VRX appliance (P14 deploy/image common piece;
# F-images reuses it read-only). Installed as /usr/lib/vrx-image/vrx-bootstrap-password.
#
#   vrx-bootstrap-password [--root DIR] [--user NAME] [--force]
#
# Writes under DIR (default /), both 0600 root:root, the same random password:
#   etc/vrx/bootstrap.env                          VRX_BOOTSTRAP_ADMIN_USER / VRX_BOOTSTRAP_ADMIN_PASSWORD, read once by
#                                                  vrx-firstboot (P10), which seeds the admin and then deletes the file
#   var/lib/vrx-image/console/bootstrap-password   the console banner's copy (vrx-console-banner shows it at the login
#                                                  prompt) — deleted by `vrx-console-banner check-login` after the first
#                                                  login of that admin (or when its password was changed)
# The password: 20 characters from a 56-symbol alphabet without look-alikes (no I O l o 0 1) and without a backslash
# (agetty expands backslash escapes in issue files): ~116 bits from /dev/urandom, rejection-sampled (no modulo bias).
# It is never printed, logged or put in argv/environment; only the two paths are reported.
# Refuses (exit 3) when the box is already initialised (var/lib/vrx/firstboot.done) or when credentials exist (both
# files kept untouched) unless --force. --root is for the installer (/target) and image builders; tests use a temp dir.
set -euo pipefail
umask 077
export LC_ALL=C

ROOT=/ USER_NAME=admin FORCE=0
die() { printf 'vrx-bootstrap-password: ERROR: %s\n' "$*" >&2; exit "${2:-1}"; }
log() { printf 'vrx-bootstrap-password: %s\n' "$*"; }

while (($#)); do
  case $1 in
    --root) ROOT=${2:?--root needs a directory}; shift ;;
    --user) USER_NAME=${2:?--user needs a name}; shift ;;
    --force) FORCE=1 ;;
    -h|--help) sed -n '2,/^set -euo pipefail/{/^set -euo pipefail/!p}' "$0" | sed -E 's/^# ?//'; exit 0 ;;
    *) die "unknown argument '$1' (try --help)" 2 ;;
  esac
  shift
done

[[ $EUID -eq 0 || $ROOT != / ]] || die "root only (or give --root DIR)"
[[ -d $ROOT ]] || die "--root $ROOT is not a directory"
ROOT=${ROOT%/}
# the API's username primitive: lower-case, starts with a letter (management.users); no shell or issue metacharacters
[[ $USER_NAME =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "--user '$USER_NAME' is not a valid user name ([a-z][a-z0-9_-]{0,31})" 2

ENV_FILE=$ROOT/etc/vrx/bootstrap.env
CONSOLE_DIR=$ROOT/var/lib/vrx-image/console
CONSOLE_FILE=$CONSOLE_DIR/bootstrap-password

if [[ -e $ROOT/var/lib/vrx/firstboot.done ]] && ((!FORCE)); then
  die "this box is already initialised ($ROOT/var/lib/vrx/firstboot.done): no new bootstrap password (use the UI or vrx-authctl)" 3
fi
if [[ -e $ENV_FILE || -e $CONSOLE_FILE ]] && ((!FORCE)); then
  die "bootstrap credentials already exist ($ENV_FILE / $CONSOLE_FILE): kept (--force replaces them)" 3
fi

ALPHABET='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789'
gen_password() { # prints nothing; sets PW (20 characters)
  local n=${#ALPHABET} limit b
  limit=$((256 - 256 % n))   # bytes >= limit are rejected so every symbol is equally likely
  PW=''
  while ((${#PW} < 20)); do
    for b in $(od -An -tu1 -N64 /dev/urandom); do
      ((b < limit)) || continue
      PW+=${ALPHABET:b%n:1}
      ((${#PW} == 20)) && break
    done
  done
}

new_tmp() { # <path>: a 0600 temp file next to <path> (renamed into place by commit)
  TMP=$(mktemp "$1.XXXXXX")
  chmod 0600 "$TMP"
  if [[ $EUID -eq 0 ]]; then chown 0:0 "$TMP"; fi
}
commit() { # <path>: fsync + atomic rename of $TMP
  sync -f "$TMP" 2>/dev/null || true
  mv -f "$TMP" "$1"
}

PW=''
gen_password
[[ ${#PW} -eq 20 ]] || die "password generation failed"

install -d -m 0755 "$ROOT/etc/vrx"
install -d -m 0755 "$ROOT/var/lib/vrx-image"
install -d -m 0700 "$CONSOLE_DIR"
# printf is a bash builtin: the secret never appears in a process argv or environment
new_tmp "$ENV_FILE"
printf '# written by vrx-bootstrap-password: read once by vrx-firstboot, then deleted\nVRX_BOOTSTRAP_ADMIN_USER=%s\nVRX_BOOTSTRAP_ADMIN_PASSWORD=%s\n' \
  "$USER_NAME" "$PW" > "$TMP"
commit "$ENV_FILE"
new_tmp "$CONSOLE_FILE"
printf '%s\n%s\n' "$USER_NAME" "$PW" > "$TMP"
commit "$CONSOLE_FILE"
PW=''
log "first-admin credentials for '$USER_NAME' written: ${ENV_FILE#"$ROOT"} and ${CONSOLE_FILE#"$ROOT"} (0600 root; the password is shown only on the console)"
