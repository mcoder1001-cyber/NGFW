{
  "vrfs": {
    "default": { "id": 0, "description": "global routing table" },
    "customer-a": { "id": 10, "description": "customer A" }
  },
  "interfaces": {
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "description": "uplink",
      "mtu": 1500,
      "ipv4": ["198.51.100.2/30"],
      "ipv6": ["2001:db8:0:1::2/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "description": "lan",
      "mtu": 1500,
      "ipv4": ["192.168.10.1/24"],
      "ipv6": ["2001:db8:10::1/64"],
      "vrf": "default",
      "rxMode": "polling"
    },
    "TenGigabitEthernet0/0/2": {
      "enabled": true,
      "description": "customer A access",
      "mtu": 1500,
      "ipv4": ["10.20.0.1/24"],
      "vrf": "customer-a",
      "rxMode": "polling"
    }
  },
  "services": {
    "snmp": {
      "enabled": true,
      "vrf": "default",
      "listen": [{ "address": "192.168.10.1" }],
      "sysLocation": "rack 12",
      "sysContact": "noc@lab.example",
      "communities": {
        "monitoring": {
          "secretRef": "password/snmp-monitoring",
          "access": "ro",
          "sources": ["192.168.10.0/24"]
        }
      },
      "v3Users": {
        "noc": {
          "securityLevel": "authPriv",
          "authProtocol": "sha256",
          "authRef": "password/snmp-noc-auth",
          "privProtocol": "aes",
          "privRef": "password/snmp-noc-priv"
        }
      },
      "trapReceivers": [
        { "address": "192.168.10.5", "version": "v3", "user": "noc" },
        {
          "address": "nms.lab.example",
          "version": "v2c",
          "community": "monitoring",
          "inform": true
        }
      ]
    },
    "lldp": {
      "enabled": true,
      "txHold": 4,
      "txIntervalSec": 30,
      "interfaces": [
        { "interface": "TenGigabitEthernet0/0/0", "portDescription": "uplink" },
        {
          "interface": "TenGigabitEthernet0/0/1",
          "mgmtIpv4": "192.168.10.1",
          "mgmtOid": "1.3.6.1.4.1.99999"
        }
      ]
    },
    "ipfix": {
      "exporters": {
        "collector-1": {
          "collector": { "address": "192.168.10.6", "port": 4739 },
          "sourceAddress": "192.168.10.1",
          "vrf": "default"
        }
      },
      "flowprobe": {
        "activeTimerSec": 15,
        "passiveTimerSec": 120,
        "interfaces": [{ "interface": "TenGigabitEthernet0/0/0", "direction": "both" }]
      },
      "sflow": {
        "enabled": true,
        "samplingN": 4096,
        "collectors": [{ "address": "192.168.10.6" }],
        "agentAddress": "192.168.10.1",
        "vrf": "default",
        "interfaces": ["TenGigabitEthernet0/0/0"]
      }
    },
    "ntp": {
      "enabled": true,
      "vrf": "default",
      "servers": [
        { "address": "time.cloudflare.com", "nts": true },
        { "address": "192.168.10.7", "iburst": true, "prefer": true, "keyRef": "key/ntp-1" }
      ],
      "allow": ["192.168.10.0/24", "10.20.0.0/24"],
      "listen": ["192.168.10.1"]
    }
  }
}
