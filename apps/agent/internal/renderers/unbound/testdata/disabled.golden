# Generated by vrx-agent (RF-3 unbound renderer). Do not edit: the next commit overwrites it.
# no enabled resolver: idle instance on loopback
server:
	directory: "/run/vrx-test/w0/unbound"
	chroot: ""
	username: ""
	pidfile: "/run/vrx-test/w0/unbound/unbound.pid"
	do-daemonize: no
	use-syslog: no
	logfile: "/run/vrx-test/w0/unbound/unbound.log"
	verbosity: 1
	port: 3653
	interface: 127.0.0.1@3653
	num-threads: 1
	msg-cache-size: 0m
	rrset-cache-size: 0m
	cache-min-ttl: 0
	cache-max-ttl: 0
	prefetch: no
	qname-minimisation: no
	hide-identity: no
	hide-version: no
	log-queries: no
	harden-glue: yes
	harden-below-nxdomain: yes
	harden-dnssec-stripped: no
	module-config: "iterator"

remote-control:
	control-enable: yes
	control-interface: "/run/vrx-test/w0/unbound/unbound.ctl"
	control-use-cert: no

