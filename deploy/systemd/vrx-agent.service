[Unit]
Description=VRX dataplane agent
Requires=vpp.service vrx-firstboot.service nftables.service
After=vpp.service vrx-firstboot.service nftables.service
ConditionPathExists=/var/lib/vrx/firstboot-complete

[Service]
Type=simple
User=root
Group=vrx
ExecStart=/usr/sbin/vrx-agent
Environment=VRX_BASE_POLICY=1 VRX_GLOBALS_OWNER=1 VRX_SOCKET_GROUP=vrx VRX_AGENT_STATE_DIR=/var/lib/vrx/agent
# Dedicated appliance scope only; never start this unit on the shared lab host.
Environment=VRX_VPP_ID_RANGE=all
EnvironmentFile=-/etc/vrx/agent.env
Restart=always
RestartSec=3
RuntimeDirectory=vrx
RuntimeDirectoryMode=0750
StateDirectory=vrx/agent
StateDirectoryMode=0750
UMask=0027
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictNamespaces=~cgroup
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_IPC_LOCK
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/vrx/agent /var/lib/vrx/captures /etc/vrx/rsyslog-tls /run/vrx
ReadWritePaths=-/etc/frr -/etc/swanctl -/etc/kea -/etc/unbound -/etc/chrony -/etc/rsyslog.d -/etc/snmp -/etc/keepalived

[Install]
WantedBy=multi-user.target
