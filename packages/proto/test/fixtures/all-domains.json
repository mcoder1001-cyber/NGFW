{
  "system": {
    "hostname": "vrx-a",
    "timezone": "Asia/Tehran",
    "banner": { "login": "Authorised access only." },
    "dns": { "servers": ["10.0.0.53", "2001:db8::53"], "searchDomains": ["lab.example"], "vrf": "default" }
  },
  "dataplane": {
    "workers": 4,
    "corelist": [2, 3, 4, 8],
    "mainCore": 1,
    "rxQueues": 2,
    "txQueues": 2,
    "hugepagesGb": 4,
    "pciWhitelist": ["0000:0b:00.0", "0000:13:00.0"]
  },
  "interfaces": {
    "loop0": {
      "enabled": true,
      "description": "router id",
      "ipv4": ["10.255.0.1/32"],
      "vrf": "default",
      "promiscuous": true
    },
    "TenGigabitEthernet0/0/0": {
      "enabled": true,
      "mtu": 9000,
      "mac": "02:00:00:00:00:01",
      "ipv4": ["10.0.0.1/24"],
      "ipv6": ["2001:db8::1/64"],
      "vrf": "default",
      "rxMode": "adaptive",
      "promiscuous": false,
      "dhcpClient": { "hostname": "vrx-a", "setBroadcastFlag": true }
    },
    "TenGigabitEthernet0/0/1": {
      "enabled": true,
      "vrf": "customer-a",
      "unnumbered": "loop0",
      "subinterfaces": {
        "200": {
          "vlanId": 200,
          "innerVlanId": 20,
          "dot1ad": true,
          "enabled": true,
          "ipv4": ["192.168.200.1/24"],
          "vrf": "customer-a"
        }
      }
    }
  },
  "vrfs": {
    "default": { "id": 0 },
    "customer-a": { "id": 10, "description": "customer A" }
  },
  "routing": {
    "static": [
      {
        "prefix": "0.0.0.0/0",
        "vrf": "default",
        "nextHops": [
          { "address": "10.0.0.254", "weight": 1 },
          { "address": "10.0.0.253", "interface": "TenGigabitEthernet0/0/0", "weight": 2 }
        ],
        "distance": 1,
        "description": "default via upstream"
      },
      {
        "prefix": "192.0.2.0/24",
        "vrf": "customer-a",
        "nextHops": [{ "interface": "loop0", "weight": 1 }],
        "distance": 5
      },
      { "prefix": "198.51.100.0/24", "vrf": "default", "blackhole": true, "distance": 250 }
    ],
    "policy": {
      "prefixLists": {
        "pl-default": {
          "description": "default only",
          "family": "ipv4",
          "rules": [
            { "seq": 10, "action": "permit", "prefix": "0.0.0.0/0" },
            { "seq": 20, "action": "permit", "prefix": "10.0.0.0/8", "ge": 16, "le": 24 }
          ]
        },
        "pl-v6": { "family": "ipv6", "rules": [{ "seq": 5, "action": "deny", "prefix": "::/0" }] }
      },
      "routeMaps": {
        "rm-in": {
          "description": "upstream import",
          "entries": [
            {
              "seq": 10,
              "action": "permit",
              "match": { "prefixList": "pl-default", "asPath": "^65001_" },
              "set": { "localPref": 200, "med": 50, "community": ["65000:100"], "communityAdditive": true, "asPathPrepend": [65000, 65000] }
            }
          ]
        }
      }
    },
    "bgp": {
      "asn": 65000,
      "routerId": "10.255.0.1",
      "vrf": "default",
      "peerGroups": {
        "upstreams": {
          "remoteAs": 65001,
          "passwordRef": "password/bgp-upstream",
          "afi": { "ipv4Unicast": { "routeMapIn": "rm-in", "softReconfig": true } }
        }
      },
      "neighbors": {
        "10.0.0.254": { "peerGroup": "upstreams", "description": "upstream", "bfd": true },
        "2001:db8::fe": { "remoteAs": 65002, "shutdown": true, "afi": { "ipv6Unicast": { "enabled": true, "prefixListOut": "pl-v6" } } }
      },
      "networks": [{ "prefix": "10.255.0.0/24" }],
      "redistribute": { "connected": {}, "static": { "metric": 10, "routeMap": "rm-in" } },
      "gracefulRestart": true,
      "ebgpRequiresPolicy": true
    },
    "ospf": {
      "routerId": "10.255.0.1",
      "areas": { "0": {}, "0.0.0.51": { "type": "stub", "noSummary": true } },
      "interfaces": {
        "loop0": { "area": "0", "passive": true },
        "TenGigabitEthernet0/0/0": { "area": "0.0.0.51", "cost": 10, "networkType": "point-to-point" }
      },
      "redistribute": { "bgp": { "routeMap": "rm-in" } },
      "defaultInformationOriginate": "on"
    },
    "bfd": {
      "sessions": [
        { "interface": "TenGigabitEthernet0/0/0", "localAddress": "10.0.0.1", "peerAddress": "10.0.0.254", "desiredMinTxUs": 100000, "detectMultiplier": 3 }
      ]
    }
  },
